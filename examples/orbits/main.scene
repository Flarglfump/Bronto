# Bronto scene - Orbits: the sun, two planets and a moon, moved by the game's C code (src/orbits.c)
bronto_scene 1

entity
  Name
    text = "Sky"
  Transform
    position = 160 90
  Shape
    kind = rect
    size = 320 180
    color = #0b1020ff
    layer = -10

entity
  Name
    text = "Sun"
  Transform
    position = 160 90
  Shape
    kind = ellipse
    size = 30 30
    color = #ffc23aff
    layer = 1
  Script
    file = "Twinkle"

entity
  Name
    text = "Earth"
