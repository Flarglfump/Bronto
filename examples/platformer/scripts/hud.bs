# The coin counter in the top-left corner.
var coins = 0
var total = 0

func start() {
    total = len(find_all("Coin"))
    show()
}

func collect() {
    coins += 1
    self.Label.size = 1.6                       # a little pop (a tween takes it back)
    tween(self, "Label.size", 1, 0.3, "back_out")
    show()
}

func show() {
    if coins == total and total > 0 {
        self.Label.text = "All " + total + " coins!"
        self.Label.color = rgb(120, 255, 140)
    } else {
        self.Label.text = "Coins: " + coins + " / " + total
    }
}

# On a touch screen, the help in the corner names the on-screen buttons instead of the keys.
func update(dt) {
    var help = find("Help")
    if help != nil and last_input() == "touch" { help.Label.text = "< > and JUMP" }
}
