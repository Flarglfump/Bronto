# A puff of gold sparks where a coin was picked up: gives off its burst once,
# then goes (auto_destroy). coin.bs spawns it.
bronto_scene 1

entity
  Name
    text = "Sparkle"
  Transform
    position = 0 0
  Particles
    emitting = true
    rate = 0
    burst = 14
    max = 40
    lifetime = 0.45
    lifetime_random = 0.4
    speed = 70
    speed_random = 0.6
    angle = -90
    spread = 180
    gravity = 120
    drag = 2
    size_start = 3
    size_end = 1
    color_start = #fff0a0ff
    color_end = #ffb02000
    shape = square
    blend = add
    layer = 2
    auto_destroy = true
