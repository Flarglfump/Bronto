# Marble - a 3D example made of scenes and scripts. Open this folder in the editor.
# Made by tools/make_marble.py; edit it in the editor from here on.
bronto_scene 1

entity
  Name
    text = "Sun"
  Transform3D
    position = 0 10 0
    rotation = -55 35 0
    scale = 1 1 1
  Light
    kind = directional
    color = #fff4e0ff
    intensity = 1

entity
  Name
    text = "Sky Light"
  Transform3D
    position = 0 10 0
    rotation = 0 0 0
    scale = 1 1 1
  Light
    kind = ambient
    color = #8090b0ff
    intensity = 0.45

entity
  Name
    text = "Camera"
  Transform3D
    position = 0 4.5 7
    rotation = -28 0 0
    scale = 1 1 1
  Camera3D
    fov = 60
    near_clip = 0.1
    far_clip = 200
    clear_color = #7cb4e8ff
    fog = true
    fog_color = #7cb4e8ff
    fog_start = 18
    fog_end = 60
  Script
    file = "scripts/camera.bs"

