# Explorer - a 3D example: walk the hills, find the crystals. Open this folder in the editor.
# Made by tools/make_explorer.py; edit it in the editor from here on.
bronto_scene 1

entity
  Name
    text = "Sun"
  Transform3D
    position = 0 20 0
    rotation = -50 -30 0
    scale = 1 1 1
  Light
    kind = directional
    color = #fff2dcff
    intensity = 1
    shadows = true
    shadow_range = 16

entity
  Name
    text = "Sky Light"
  Transform3D
    position = 0 20 0
    rotation = 0 0 0
    scale = 1 1 1
  Light
    kind = ambient
    color = #8898c0ff
    intensity = 0.45

entity
  Name
    text = "Camera"
  Transform3D
    position = 0 5 9
    rotation = 0 0 0
    scale = 1 1 1
  Camera3D
    fov = 60
    near_clip = 0.1
    far_clip = 120
    clear_color = #9cc4ecff
    fog = true
    fog_color = #9cc4ecff
    fog_start = 14
    fog_end = 40
  Script
    file = "scripts/camera.bs"

