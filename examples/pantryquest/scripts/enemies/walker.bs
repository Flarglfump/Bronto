# Walkers: the tomatoes, plums and burger knights of the Pantry Plains, and
# the breadstick soldiers, toast knights and candy-corn soldiers of the cellars. They walk from tile to tile, now
# and then stop and throw something (if `shot` is set), and hurt Pip when
# they touch him. One script, set up per kind by the vars in its prefab.

var hp: number = 1
var size: number = 6                # how far from its centre a poke reaches it
var damage: number = 1              # half hearts, when it touches Pip
var speed: number = 30
var image: string = "art/tomato_"   # + "0.bmp" / "1.bmp"
var shot: string = ""               # a prefab it throws, or ""
var shot_speed: number = 110
var shot_chance: number = 0.22      # at each tile, the chance it stops to throw
var aim: bool = false             # throws only towards Pip, when lined up with him
var cutter_kills: bool = false    # the pizza cutter only stuns most things
var front_guard: bool = false     # a poke, skewer or spark from in front just glances off (toast knights)
var game: entity
var hero: entity
var map: entity
var appear_t: number = 0
var dir := vec2(0, 1)
var target := vec2(0, 0)
var moving: bool = false
var wait_t: number = 0
var anim_t: number = 0
var frame: number = 0
var flash_t: number = 0
var knock := vec2(0, 0)
var knock_t: number = 0
var stun_t: number = 0

func start() -> void {
    game = find("Game")
    hp = game.enemy_hp(hp, self.parent)                # (tougher later in the game)
    damage = game.enemy_damage(damage, self.parent)
    hero = find("Hero")
    map = child(self.parent, "Map")
    appear_t = 0.3 + random(0.6)
    self.Sprite.image = "art/cloud_0.bmp"
    var dirs := [vec2(0, 1), vec2(0, -1), vec2(1, 0), vec2(-1, 0)]
    dir = dirs[floor(random(4))]
}

func free(p: vec2) -> bool {
    if p.x < 24 or p.x > 232 or p.y < 24 or p.y > 152 { return false }
    return not tile_solid(map, self.parent.global_position + p)
}

func snap(p: vec2) -> vec2 { return vec2(floor(p.x / 16) * 16 + 8, floor(p.y / 16) * 16 + 8) }

func update(dt: number) -> void {
    if game.state != "play" { return }
    if appear_t > 0 {
        appear_t -= dt
        if appear_t < 0.15 { self.Sprite.image = "art/cloud_1.bmp" }
        if appear_t <= 0 {
            self.Sprite.image = image + "0.bmp"
            target = snap(self.position)
            moving = true
        }
        return
    }
    if flash_t > 0 {
        flash_t -= dt
        if floor(flash_t * 24) % 2 == 0 { self.Sprite.tint = rgb(255, 255, 255, 90) } else { self.Sprite.tint = rgb(255, 255, 255) }
        if flash_t <= 0 { self.Sprite.tint = rgb(255, 255, 255) }
    }
    if knock_t > 0 {
        knock_t -= dt
        var to := self.position + knock * 4
        if free(snap(to)) or free(to) { self.position = to }
        if knock_t <= 0 {
            target = snap(self.position)
            moving = true
        }
        touch()
        return
    }
    if stun_t > 0 {
        stun_t -= dt
        touch()
        return
    }
    if moving {
        var to := target - self.position
        var step := speed * dt
        if length(to) <= step {
            self.position = target
            moving = false
        } else {
            self.position += normalize(to) * step
        }
    } elif wait_t > 0 {
        wait_t -= dt
    } else {
        decide()
    }
    anim_t += dt
    if anim_t > 0.2 {
        anim_t = 0
        frame = 1 - frame
        self.Sprite.image = image + frame + ".bmp"
    }
    if dir.x < 0 { self.scale = vec2(-1, 1) } elif dir.x > 0 { self.scale = vec2(1, 1) }
    touch()
}

func touch() -> void {
    if hero.touches(self.global_position, size) { hero.hurt(damage, self.global_position) }
}

func lined_up() -> vec2 {
    var d := hero.position - self.global_position
    if abs(d.x) < 8 { return vec2(0, sign(d.y)) }
    if abs(d.y) < 8 { return vec2(sign(d.x), 0) }
    return vec2(0, 0)
}

func decide() -> void {
    if shot != "" and len(find_all("Shot")) < 3 {
        var throw := vec2(0, 0)
        if aim {
            throw = lined_up()
        } elif random() < shot_chance {
            throw = dir
        }
        if throw.x != 0 or throw.y != 0 {
            dir = throw
            var s := spawn(shot, self.position + dir * 8, self.parent)
            s.vel = dir * shot_speed
            s.rotation = angle(dir) + 90
            wait_t = 0.45
            return
        }
    }
    var dirs := [vec2(0, 1), vec2(0, -1), vec2(1, 0), vec2(-1, 0)]
    if random() < 0.35 or not free(self.position + dir * 16) {
        var options := []
        for d in dirs {
            if free(self.position + d * 16) { push(options, d) }
        }
        if len(options) == 0 {
            wait_t = 0.3
            return
        }
        dir = options[floor(random(len(options)))]
    }
    target = self.position + dir * 16
    moving = true
}

# A poke (or bomb, beam, cutter) landed. True if it counted.
func hit(amount: number, d: vec2, kind: string) -> bool {
    if game == nil { return false }                   # (it has only just appeared: not started yet)
    if appear_t > 0 or knock_t > 0 or flash_t > 0.15 { return false }
    if kind == "cutter" and not cutter_kills {
        stun_t = 1.6
        play_sound("sfx/tink.wav", 0.6)
        return true
    }
    if front_guard and kind != "bomb" and kind != "fire" and dot(d, dir) < -0.5 {
        play_sound("sfx/tink.wav", 0.6)            # straight into its buttered front
        return true
    }
    hp -= amount
    play_sound("sfx/hit.wav")
    if hp <= 0 {
        game.enemy_killed(self)
        destroy(self)
        return true
    }
    flash_t = 0.4
    if abs(d.x) > abs(d.y) { knock = vec2(sign(d.x), 0) } else { knock = vec2(0, sign(d.y)) }
    knock_t = 0.12
    return true
}
