# Baron Gorge, who tore the Grand Recipe apart: the last guardian, in three
# courses. His bar counts all of them down: 40 points of health, 14 + 14 + 12
# (twenty pokes with the silver ladle, fourteen with the golden one).
#
#   1. THE FEAST (14): he sits behind his banquet table, sliding from end to
#      end and flinging dishes three at a time; now and then he rings for a
#      waiter. Every third throw he leans over the table to slam it - only
#      then can Pip, waiting just below the table, reach him.
#   2. GORGE (14): he smashes the table and chases Pip, and every few seconds
#      breathes in so hard he drags Pip (and anything loose) towards him.
#      His belly turns every hit - but a popcorn bomb pulled into his mouth
#      goes down whole and stuns him, and then he can be hurt. Bombs drop
#      in while Pip has few.
#   3. THE LAST COURSE (12): he hides under one of three dish covers, which
#      shuffle (faster as he weakens) and lift: under his, him, and he can
#      be hit; under the others, a dish thrown, or a meatball.

var hp = 40
var hp_max = 40
var title = "BARON GORGE"
var subtitle = "LORD OF THE BANQUET HALL"
var size = 14
var damage = 2
var game
var hero
var appear_t = 0
var phase = 1
var mode = "slide"          # 1: slide, lean;  2: chase, inhale, stunned;  3: covered, shuffle, lift;  rage (between)
var mode_t = 1.5
var t = 0
var flash_t = 0
var throws = 0
var dir = 1
var home_y = 36             # behind the table
var bomb_t = 4
var covers = []             # phase 3: the three dish covers
var spots = [vec2(64, 96), vec2(128, 96), vec2(192, 96)]
var under = 1               # the cover he is under
var swaps = 0
var swap_a = 0
var swap_b = 1
var lifted = false

func start() {
    game = find("Game")
    damage = game.enemy_damage(damage, self.parent)
    hero = find("Hero")
    appear_t = 1                                       # until his entrance is over (game.boss_arrives)
}

func intro_done() {
    appear_t = 0
    mode = "slide"
    mode_t = 1.2
}

func local_hero() { return hero.position - self.parent.global_position }

func set_face(open) {
    if open { self.Sprite.image = "art/baron_1.bmp" } else { self.Sprite.image = "art/baron_0.bmp" }
}

func throw_dishes(n, spread, speed) {
    var aim = angle(local_hero() - self.position)
    for i in n {
        var a = aim + (i - (n - 1) / 2) * spread
        var s = spawn("prefabs/dish.scene", self.position + vec2(0, 10), self.parent)
        s.vel = from_angle(a, speed)
    }
    play_sound("sfx/swing.wav")
}

func enemies_out() {
    var n = 0
    for e in children(self.parent) {
        if e.name == "Enemy" and e.id != self.id { n += 1 }
    }
    return n
}

func update(dt) {
    if game.state != "play" { return }
    if appear_t > 0 {
        game.boss_arrives(self)
        return
    }
    t += dt
    mode_t -= dt
    if flash_t > 0 { flash_t -= dt }
    var c = 255
    if flash_t > 0 and floor(flash_t * 24) % 2 == 0 { c = 120 }
    var alpha = 255
    if phase == 3 and not (mode == "lift") and mode != "rage" { alpha = 0 }
    self.Sprite.tint = rgb(255, c, c, alpha)
    if mode == "rage" { rage(dt) }
    elif phase == 1 { feast(dt) }
    elif phase == 2 { gorge(dt) }
    else { last_course(dt) }
    var reach = size
    if phase == 2 { reach = size * 1.3 }
    if alpha > 0 and mode != "rage" and hero.touches(self.global_position, reach) { hero.hurt(damage, self.global_position) }
}

# ---- 1: the feast -------------------------------------------------------------------
func feast(dt) {
    if mode == "slide" {
        set_face(false)
        self.position = vec2(self.position.x + dir * 34 * dt, home_y)
        if self.position.x > 184 { dir = -1 }
        if self.position.x < 72 { dir = 1 }
        if mode_t <= 0 {
            throws += 1
            if throws % 3 == 0 {
                mode = "lean"
                mode_t = 1.6
                play_sound("sfx/charge.wav", 0.6)
            } else {
                throw_dishes(3, 22, 92)
                if throws % 4 == 1 and enemies_out() < 2 {      # "Waiter!"
                    spawn("prefabs/toast.scene", vec2(clamp(local_hero().x, 48, 208), 120), self.parent)
                }
                mode_t = 1.6
            }
        }
    } elif mode == "lean" {                            # over the table: down to Pip's side
        set_face(true)
        var k = clamp((1.6 - mode_t) / 0.25, 0, 1)
        self.position = vec2(self.position.x, home_y + 22 * k)
        if mode_t < 1.3 and mode_t + dt >= 1.3 {
            for a in [45, 90, 135] {
                var s = spawn("prefabs/dish.scene", self.position + vec2(0, 12), self.parent)
                s.vel = from_angle(a, 80)
            }
            play_sound("sfx/explode.wav", 0.5)
        }
        if mode_t <= 0 {
            self.position = vec2(self.position.x, home_y)
            mode = "slide"
            mode_t = 1.4
        }
    }
}

# ---- 2: gorge -------------------------------------------------------------------------
func gorge(dt) {
    bomb_t -= dt
    if bomb_t <= 0 {                                   # bombs, while Pip is short of them
        bomb_t = 7
        if game.bombs < 2 and len(find_all("Pickup")) < 2 {
            var p = spawn("prefabs/pickup.scene", vec2(48 + random(160), 56 + random(80)), self.parent)
            p.kind = "bomb"
            p.timeout = 12
        }
    }
    var to = local_hero() - self.position
    if mode == "chase" {
        set_face(false)
        if length(to) > 6 { self.position += normalize(to) * 28 * dt }
        keep_in()
        if mode_t <= 0 {
            mode = "inhale"
            mode_t = 2.2
            play_sound("sfx/charge.wav")
        }
    } elif mode == "inhale" {
        set_face(true)
        self.scale = vec2(1.3 + sin(t * 2000) * 0.04, 1.3)
        var pull = normalize(self.global_position - hero.position)  # Pip is dragged in...
        if length(to) < 150 {
            hero.walk(vec2(sign(pull.x), 0), abs(pull.x) * 40 * dt, false)
            hero.walk(vec2(0, sign(pull.y)), abs(pull.y) * 40 * dt, false)
        }
        for b in find_all("Bomb") {                    # ...and so is a bomb
            var d = self.global_position - b.global_position
            if length(d) < 18 {
                destroy(b)
                mode = "stunned"
                mode_t = 2.6
                play_sound("sfx/pop.wav")
                play_sound("sfx/hurt.wav", 0.6)
                game.say("", "")
                return
            }
            if length(d) < 120 { b.position += normalize(d) * 70 * dt }
        }
        if mode_t <= 0 {
            self.scale = vec2(1.3, 1.3)
            mode = "chase"
            mode_t = 2.5 + random(1.5)
        }
    } elif mode == "stunned" {                         # a bomb went off inside: dizzy
        set_face(true)
        self.rotation = sin(t * 900) * 8
        if mode_t <= 0 {
            self.rotation = 0
            mode = "chase"
            mode_t = 2 + random(1)
        }
    }
}

func keep_in() {
    self.position = vec2(clamp(self.position.x, 48, 208), clamp(self.position.y, 52, 124))
}

# ---- 3: the last course -------------------------------------------------------------
func last_course(dt) {
    if mode == "covered" {                             # the covers come down
        for i in 3 { covers[i].position = lerp(covers[i].position, cover_spot(i, false), min(1, dt * 8)) }
        if mode_t <= 0 {
            mode = "shuffle"
            swaps = 5 + floor((12 - hp) / 4) * 2
            next_swap()
        }
    } elif mode == "shuffle" {
        var k = clamp(1 - mode_t / swap_time(), 0, 1)
        var pa = spots[swap_a]
        var pb = spots[swap_b]
        var lift = sin(k * 180) * 14
        covers_at(swap_a).position = lerp(pa, pb, k) + vec2(0, -lift)
        covers_at(swap_b).position = lerp(pb, pa, k) + vec2(0, lift)
        if mode_t <= 0 {
            var a = covers_at(swap_a)                  # (the covers trade places)
            var b = covers_at(swap_b)
            a.spot = swap_b
            b.spot = swap_a
            a.position = spots[swap_b]
            b.position = spots[swap_a]
            swaps -= 1
            if swaps > 0 { next_swap() } else {
                mode = "lift"
                mode_t = 1.7
                lifted = false
            }
        }
    } elif mode == "lift" {
        for i in 3 { covers[i].position = lerp(covers[i].position, cover_spot(covers[i].spot, true), min(1, dt * 10)) }
        if not lifted {
            lifted = true
            play_sound("sfx/shutter.wav", 0.6)
            for cv in covers {
                if cv.spot != under {
                    if random() < 0.5 and enemies_out() < 2 {
                        spawn("prefabs/meatball.scene", spots[cv.spot], self.parent)
                    } else {
                        var aim = angle(local_hero() - spots[cv.spot])
                        for a in [-15, 15] {
                            var s = spawn("prefabs/dish.scene", spots[cv.spot], self.parent)
                            s.vel = from_angle(aim + a, 90)
                        }
                    }
                }
            }
        }
        set_face(mode_t < 0.9)
        self.position = spots[under] + vec2(0, 2)
        if mode_t <= 0 {
            mode = "covered"
            mode_t = 0.5
        }
    }
    if mode != "lift" { self.position = spots[under] + vec2(0, 2) }
}

func swap_time() { return 0.3 + hp * 0.02 }

func cover_spot(i, up) {
    if up { return spots[i] + vec2(0, -18) }
    return spots[i]
}

func covers_at(spot) {
    for cv in covers {
        if cv.spot == spot { return cv }
    }
    return covers[0]
}

func next_swap() {
    swap_a = floor(random(3))
    swap_b = (swap_a + 1 + floor(random(2))) % 3
    if under == swap_a { under = swap_b } elif under == swap_b { under = swap_a }   # he goes with his cover
    mode_t = swap_time()
    play_sound("sfx/menu.wav", 0.5)
}

# ---- between courses -------------------------------------------------------------------
func rage(dt) {
    set_face(true)
    self.rotation = sin(t * 2400) * 6
    if mode_t <= 0 {
        self.rotation = 0
        if phase == 2 { start_gorge() } else { start_last_course() }
    }
}

func next_phase() {
    phase += 1
    mode = "rage"
    mode_t = 1.6
    flash_t = 0
    play_sound("sfx/roar.wav")
    for s in find_all("Shot") { destroy(s) }
    for b in find_all("Bomb") { destroy(b) }
}

func start_gorge() {
    var map = child(self.parent, "Map")                # the table goes flying
    for c in range(2, 14) {
        var p = self.parent.global_position + vec2(c * 16 + 8, 4 * 16 + 8)
        if tile_at(map, p) == "T" {
            set_tile(map, p, ".")
            spawn("prefabs/puff.scene", p - self.parent.global_position, self.parent)
        }
    }
    play_sound("sfx/explode.wav")
    self.scale = vec2(1.3, 1.3)
    self.position = vec2(128, 64)
    mode = "chase"
    mode_t = 2
    bomb_t = 0.5
    game.say("HE'LL SWALLOW ANYTHING...", "EVEN A POPCORN BOMB?")
}

func start_last_course() {
    self.scale = vec2(1, 1)
    for i in 3 {
        var cv = spawn("prefabs/cloche.scene", spots[i] + vec2(0, -40), self.parent)
        cv.spot = i
        push(covers, cv)
    }
    under = 1
    mode = "covered"
    mode_t = 0.8
    play_sound("sfx/shutter.wav")
}

func hit(amount, d, kind) {
    if appear_t > 0 or flash_t > 0.2 or mode == "rage" { return false }
    var open = (phase == 1 and mode == "lean") or (phase == 2 and mode == "stunned") or (phase == 3 and mode == "lift")
    if not open {
        if phase == 3 { return false }                 # (under a cover: nothing to hit)
        play_sound("sfx/tink.wav", 0.6)
        flash_t = 0.25
        return true
    }
    if kind == "cutter" { return false }
    hp -= amount
    flash_t = 0.45
    play_sound("sfx/hit.wav")
    if phase == 1 and hp <= 26 {
        hp = 26
        next_phase()
    } elif phase == 2 and hp <= 12 {
        hp = 12
        next_phase()
    } elif hp <= 0 {
        hp = 0
        defeated()
    }
    return true
}

func defeated() {
    play_sound("sfx/boss_die.wav")
    for cv in covers { destroy(cv) }
    for e in children(self.parent) {
        if e.name == "Enemy" and e.id != self.id { destroy(e) }
    }
    for s in find_all("Shot") { destroy(s) }
    for off in [vec2(-14, -12), vec2(12, -10), vec2(0, 8), vec2(-14, 12), vec2(14, 12), vec2(0, -16)] {
        spawn("prefabs/puff.scene", self.position + off, self.parent)
    }
    game.boss_beaten()
    destroy(self)
}
