# A room: its root entity (all the room's tiles, enemies and things are its
# children). It keeps its doors as they were left, shuts its shutters while
# enemies remain, and remembers when it has been cleared.

var id = ""                 # its file name: "ow_7_7", "d1_2_3", "cave_chef"
var region = ""             # the part of the land it is in ("LETTUCE WOODS"): shown as Pip comes in
var title = ""              # a name of its own to show instead (an unbuilt cellar's)
var music = ""              # the track while Pip is here ("" = silence)
var shut = ""               # sides whose shutters close while enemies remain, e.g. "s" or "ns"
var stays_clear = false     # once cleared, its enemies don't come back (the cellars)
var exit_n = ""             # leaving by this side goes to this room instead of the next one
var exit_s = ""             #   ("back" = where Pip came from: for caves)
var exit_e = ""
var exit_w = ""
var exit_pos := vec2(128, 200)
var exit_face = "down"
var game
var shutting = false
var started = false

func start() {
    game = find("Game")
    var map = child(self, "Map")
    for side in ["n", "s", "e", "w"] {
        if game.has_flag("open:" + id + ":" + side) {
            for c in game.door_cells(side) { set_tile(map, self.global_position + vec2(c.x * 16 + 8, c.y * 16 + 8), ",") }
        }
    }
    if stays_clear and game.has_flag("clear:" + id) {
        for e in children(self) {
            if e.name == "Enemy" { destroy(e) }
        }
    }
    started = true
}

# Pip has arrived (the slide or fade is over).
func entered() {
    if shut != "" and enemies() > 0 {
        for i in len(shut) { game.set_door(shut[i], "H") }
        shutting = true
        play_sound("sfx/shutter.wav")
    }
}

func enemies() {
    var n = 0
    for e in children(self) {
        if e.name == "Enemy" { n += 1 }
    }
    return n
}

func update(dt) {
    if not started or game.state != "play" or game.room != self { return }
    if enemies() == 0 {
        if stays_clear and not game.has_flag("clear:" + id) { game.flag("clear:" + id) }
        if shutting {
            shutting = false
            for i in len(shut) { game.set_door(shut[i], ",") }
            play_sound("sfx/shutter.wav")
        }
    }
}
