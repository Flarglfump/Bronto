# Something an enemy threw or spat: a seed, a toothpick, a sprinkle. It
# flies straight (`vel`, set by whoever threw it) until it leaves the room,
# hits a wall, or reaches Pip - whose pot lid stops the small ones (and,
# with the baking tray, every one).

var vel := vec2(0, 0)
var damage: number = 1
var blockable: bool = true        # can Pip's lid stop it?
var walls: bool = true            # does a wall stop it?
var game: entity
var hero: entity
var map: entity

func start() -> void {
    game = find("Game")
    damage = game.enemy_damage(damage, self.parent)     # (thrown harder later in the game)
    hero = find("Hero")
    map = child(self.parent, "Map")
}

func update(dt: number) -> void {
    if game.state != "play" { return }
    self.position += vel * dt
    var p := self.position
    if p.x < -8 or p.x > 264 or p.y < -8 or p.y > 184 {
        destroy(self)
        return
    }
    var g := self.global_position
    if walls and tile_solid(map, g) {
        destroy(self)
        return
    }
    if hero.touches(g, 2) {
        if (blockable or game.has_treasure("tray")) and hero.blocks(vel) {
            play_sound("sfx/tink.wav", 0.7)
            destroy(self)
        } elif hero.hurt(damage, g) {
            destroy(self)
        }
    }
}
