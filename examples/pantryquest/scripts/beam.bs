# The spark of flavour that flies from Pip's spoon when his health is full.

var vel := vec2(0, 0)
var game
var t = 0

func start() { game = find("Game") }

func update(dt) {
    if game.state != "play" { return }
    self.position += vel * dt
    t += dt
    if floor(t * 20) % 2 == 0 { self.Sprite.tint = rgb(255, 255, 160) } else { self.Sprite.tint = rgb(255, 160, 120) }
    var p = self.position
    if p.x < 0 or p.x > 256 or p.y < 64 or p.y > 240 {
        burst()
        return
    }
    for e in find_all("Enemy") {
        if distance(e.global_position, p) < 7 + e.size and e.hit(1, normalize(vel), "beam") {
            burst()
            return
        }
    }
}

func burst() {
    spawn("prefabs/sparkle.scene", self.position)
    destroy(self)
}
