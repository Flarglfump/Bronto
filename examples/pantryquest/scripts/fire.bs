# The fire chili's flame: it rolls out two tiles, then burns where it
# stops for a moment. It scorches anything it touches, and a bush hiding a
# secret (tile Y) burns away, and a brazier it reaches catches light.

var dir := vec2(1, 0)
var travel = 0.25
var burn = 1.0
var game
var t = 0
var hit_list = []
var burned = false

func start() { game = find("Game") }

func update(dt) {
    if game.state != "play" { return }
    t += dt
    if floor(t * 10) % 2 == 0 { self.Sprite.image = "art/flame_0.bmp" } else { self.Sprite.image = "art/flame_1.bmp" }
    if travel > 0 {
        travel -= dt
        var to = self.position + dir * 128 * dt
        if to.x < 8 or to.x > 248 or to.y < 72 or to.y > 232 or tile_solid(game.map, to + dir * 6) {
            travel = 0
        } else {
            self.position = to
        }
    } else {
        if not burned {
            burned = true
            game.burn(self.position + dir * 8)
        }
        burn -= dt
        if burn <= 0 {
            destroy(self)
            return
        }
    }
    for b in find_all("Brazier") {
        if distance(b.global_position, self.position) < 22 { b.light() }
    }
    for e in find_all("Enemy") {
        if not contains(hit_list, e.id) and distance(e.global_position, self.position) < 6 + e.size {
            if e.hit(game.attack(), dir, "fire") { push(hit_list, e.id) }
        }
    }
}
