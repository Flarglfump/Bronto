# The settings: how loud the music and the sounds are, and two keys for each
# action. Up and down choose a line; left and right turn a volume or pick
# which of the two keys; Enter waits for the new key (Escape there keeps the
# old one, Delete clears it). There are more actions than fit, so their list
# scrolls (8 at a time; the arrows on the right say there's more).
#
# The mouse works too: over a line, it's chosen; click a volume's pip to set
# it, a key to change it, RESET or BACK to do that, an arrow to scroll.
#
# With a gamepad (whichever was used last: scripts/settings.bs using_pad),
# the actions show their gamepad buttons instead, one each: A waits for the
# new button, X clears it. Waiting gives up after five seconds.
# Saved as Pip leaves (scripts/settings.bs).

var s
var row = 0                 # 0 music, 1 sounds, 2 .. (1 + actions) the actions, then reset, then back
var top = 0                 # the first action in view
var col = 0                 # which key of an action
var waiting = false
var wait_t = 0
var wait_pad = false        # waiting for a gamepad button (not a key)
var was_pad = false         # (the menu shows the buttons while this is true)
var labels = []             # the 12 lines on the card: 0 music, 1 sounds, 2 to 9 actions in view, 10 reset, 11 back
var key_a = []
var key_b = []
var music_pips = []
var sound_pips = []
var row_hi
var cell_hi
var hint
var more_up
var more_down
var mouse_at := vec2(-1, -1)
var shown = 8               # actions in view at once

func start() {
    s = find("Settings")
    for i in 12 { push(labels, child(self, "Row" + i)) }
    for i in 8 {
        push(key_a, child(self, "KeyA" + i))
        push(key_b, child(self, "KeyB" + i))
    }
    for i in 10 {
        push(music_pips, child(self, "MusicPip" + i))
        push(sound_pips, child(self, "SoundPip" + i))
    }
    row_hi = child(self, "RowHi")
    cell_hi = child(self, "CellHi")
    hint = child(self, "Hint")
    more_up = child(self, "MoreUp")
    more_down = child(self, "MoreDown")
    mouse_at = mouse_position()
    was_pad = s.using_pad
    show()
}

func actions() { return len(s.actions) }
func last_row() { return actions() + 3 }
func reset_row() { return actions() + 2 }
func is_action(r) { return r >= 2 and r < 2 + actions() }

# The line on the card for a row (or -1: scrolled out of view).
func line_of(r) {
    if r <= 1 { return r }
    if is_action(r) {
        var k = r - 2 - top
        if k >= 0 and k < shown { return 2 + k }
        return -1
    }
    return r - actions() + 8                           # reset -> 10, back -> 11
}

func row_text(i) {
    if i == 0 { return "MUSIC" }
    if i == 1 { return "SOUNDS" }
    if i == reset_row() { return "RESET TO DEFAULTS" }
    if i == last_row() { return "BACK" }
    return s.names[i - 2]
}

func keep_in_view() {
    if is_action(row) {
        if row - 2 < top { top = row - 2 }
        if row - 2 >= top + shown { top = row - 2 - shown + 1 }
    }
}

func show() {
    keep_in_view()
    for r in range(0, last_row() + 1) {
        var l = line_of(r)
        if l >= 0 {
            var t = row_text(r)
            labels[l].Label.text = t
            if l < 10 { labels[l].x = -100 + len(t) * 4 } else { labels[l].x = 0 }   # names on the left, the last two centred
            if r == row { labels[l].Label.color = rgb(142, 26, 42) } else { labels[l].Label.color = rgb(98, 56, 26) }
        }
    }
    if was_pad { col = 0 }                               # (a gamepad button each: one column)
    for k in shown {
        var a = top + k
        if was_pad {
            key_a[k].Label.text = s.pad_label(s.pads[a])
            key_b[k].Label.text = ""
        } else {
            key_a[k].Label.text = s.key_label(s.keys[a][0])
            key_b[k].Label.text = s.key_label(s.keys[a][1])
        }
        if waiting and row == a + 2 {
            if col == 0 { key_a[k].Label.text = "?" } else { key_b[k].Label.text = "?" }
        }
    }
    for i in 10 {
        if i < s.music { music_pips[i].Shape.color = rgb(142, 26, 42) } else { music_pips[i].Shape.color = rgb(226, 194, 128) }
        if i < s.sounds { sound_pips[i].Shape.color = rgb(142, 26, 42) } else { sound_pips[i].Shape.color = rgb(226, 194, 128) }
    }
    row_hi.y = labels[line_of(row)].y
    if is_action(row) {
        cell_hi.Shape.color = rgb(240, 196, 120)
        cell_hi.position = vec2(38 + col * 46, labels[line_of(row)].y)
    } else {
        cell_hi.Shape.color = rgb(0, 0, 0, 0)
    }
    if top > 0 { more_up.Label.color = rgb(142, 26, 42) } else { more_up.Label.color = rgb(0, 0, 0, 0) }
    if top + shown < actions() { more_down.Label.color = rgb(142, 26, 42) } else { more_down.Label.color = rgb(0, 0, 0, 0) }
    if waiting and wait_pad { hint.Label.text = "PRESS A BUTTON" }
    elif waiting { hint.Label.text = "PRESS A KEY  (ESC: KEEP)" }
    elif is_action(row) and was_pad { hint.Label.text = "A: CHANGE  X: CLEAR" }
    elif is_action(row) { hint.Label.text = "ENTER: CHANGE  DEL: CLEAR" }
    elif row <= 1 { hint.Label.text = "<> LOUDER / SOFTER" }
    else { hint.Label.text = s.ok_label() + ": CHOOSE  " + s.back_label() + ": BACK" }
}

func close() {
    s.save()
    play_sound("sfx/menu.wav")
    destroy(self)
}

# Enter (or a click) on a row. True if the settings closed.
func choose(r) {
    if r == reset_row() {
        s.defaults()
        s.apply()
        play_sound("sfx/buy.wav")
    } elif r == last_row() {
        close()
        return true
    } elif is_action(r) {
        waiting = true
        wait_pad = was_pad
        wait_t = 0
    }
    return false
}

# The mouse: a line under it is chosen; a click on a pip, a key, a button or
# an arrow does it. "closed" if a click closed the settings, else whether to redraw.
func mouse() {
    var m = mouse_position()
    var moved = m != mouse_at
    mouse_at = m
    var click = s.clicked()
    if not moved and not click { return "" }
    if click and s.over(more_up, 14, 12) and top > 0 {
        top -= 1
        if row - 2 >= top + shown { row = top + shown + 1 }
        return "redraw"
    }
    if click and s.over(more_down, 14, 12) and top + shown < actions() {
        top += 1
        if is_action(row) and row - 2 < top { row = top + 2 }
        return "redraw"
    }
    for r in range(0, last_row() + 1) {
        var l = line_of(r)
        if l >= 0 and abs(m.y - labels[l].global_position.y) <= 5 and abs(m.x - self.global_position.x) <= 108 {
            var changed = r != row
            row = r
            if is_action(r) {                          # which key: the one under the mouse
                if s.over(key_a[l - 2], 44, 10) { col = 0 }
                if s.over(key_b[l - 2], 44, 10) { col = 1 }
            }
            if click {
                if r <= 1 {                            # a pip: that loud (the first one again: off)
                    for i in 10 {
                        var pip = music_pips[i]
                        if r == 1 { pip = sound_pips[i] }
                        if s.over(pip, 9, 10) {
                            var v = i + 1
                            if r == 0 {
                                if s.music == 1 and v == 1 { v = 0 }
                                s.music = v
                            } else {
                                if s.sounds == 1 and v == 1 { v = 0 }
                                s.sounds = v
                            }
                            s.apply()
                        }
                    }
                    return "redraw"
                }
                if is_action(r) and not (s.over(key_a[l - 2], 44, 10) or s.over(key_b[l - 2], 44, 10)) { return "redraw" }
                if choose(r) { return "closed" }
                return "redraw"
            }
            if changed { return "redraw" }
            return ""
        }
    }
    return ""
}

func update(dt) {
    if waiting {
        wait_t += dt
        if wait_t < 0.1 { return }                       # (not the Enter that started it)
        if wait_pad {
            var b = last_button()
            if b == "" and not key_pressed("escape") and wait_t < 5 { return }
            if b != "" { s.set_pad(row - 2, b) }
        } else {
            var k = last_key()
            if k == "" and wait_t < 5 { return }
            if k != "escape" and k != "" { s.set_key(row - 2, col, k) }
        }
        waiting = false
        play_sound("sfx/key.wav", 0.6)
        show()
        return
    }
    if key_pressed("escape") or button_pressed("b") {
        close()
        return
    }
    var moved = false
    if s.using_pad != was_pad {                          # (keys or buttons: whichever was used last)
        was_pad = s.using_pad
        show()
    }
    var n = last_row() + 1
    if s.nav("up") { row = (row + n - 1) % n; moved = true }
    if s.nav("down") { row = (row + 1) % n; moved = true }
    if s.nav("left") or s.nav("right") {
        var d = 1
        if s.nav("left") { d = -1 }
        if row == 0 { s.music = clamp(s.music + d, 0, 10) }
        if row == 1 { s.sounds = clamp(s.sounds + d, 0, 10) }
        if is_action(row) and not was_pad { col = clamp(col + d, 0, 1) }
        s.apply()
        moved = true
    }
    if is_action(row) and (key_pressed("delete") or key_pressed("backspace")) {
        s.keys[row - 2][col] = ""
        moved = true
    }
    if is_action(row) and was_pad and button_pressed("x") {
        s.pads[row - 2] = ""
        moved = true
    }
    if s.nav("ok") or key_pressed("enter") {
        if choose(row) { return }
        moved = true
    }
    var m = mouse()
    if m == "closed" { return }
    if m == "redraw" { moved = true }
    if moved {
        play_sound("sfx/menu.wav")
        show()
    }
}
