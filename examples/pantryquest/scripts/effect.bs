# A short animation that removes itself: `first`, then `second`, over `life` seconds.
var first: string = "art/puff_0.bmp"
var second: string = "art/puff_1.bmp"
var life: number = 0.3
var t: number = 0

func update(dt: number) -> void {
    t += dt
    if t > life / 2 { self.Sprite.image = second }
    if t >= life { destroy(self) }
}
