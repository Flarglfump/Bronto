# Anything Pip can pick up. `kind` says what (bean, bean5, heart, key, bomb,
# bombs_item, spoon, cutter, heart_pie, page, soup, map, compass, skewers, chili, plank, whisk,
# mitt, tray, ladle, recipe - the Grand Recipe, whole: the end - copper_spoon,
# golden_ladle, jacket, coat, bag - the Big Bomb Bag). `min_hearts` keeps it out of reach (unseen) until
# Pip has that many heart containers.; `flag`, if set, makes it
# a one-off that stays taken; `price` makes it something to buy; `on_clear`
# keeps it hidden until every enemy in the room is gone; `timeout` (drops)
# makes it vanish after a while.

var kind: string = "bean"
var flag: string = ""
var price: number = 0
var on_clear: bool = false
var on_solve: bool = false        # hidden until the room's puzzle is solved (scripts/room.bs)
var min_hearts: number = 0
var timeout: number = 0
var game: entity
var hero: entity
var shown: bool = true
var label: entity

func start() -> void {
    game = find("Game")
    hero = find("Hero")
    if flag != "" and game.has_flag(flag) {
        destroy(self)
        return
    }
    var images := ["bean", "art/bean.bmp", "bean5", "art/bean_gold.bmp", "heart", "art/heart.bmp", "key", "art/key.bmp",
                  "bomb", "art/bomb.bmp", "bombs_item", "art/bomb.bmp", "spoon", "art/spoon.bmp", "cutter", "art/cutter.bmp",
                  "heart_pie", "art/heart_pie.bmp", "page", "art/page.bmp", "soup", "art/soup.bmp",
                  "map", "art/dmap.bmp", "compass", "art/compass.bmp", "skewers", "art/skewer.bmp", "chili", "art/chili.bmp",
                  "plank", "art/plank.bmp", "whisk", "art/whisk.bmp", "mitt", "art/mitt.bmp", "tray", "art/tray.bmp",
                  "ladle", "art/ladle.bmp", "recipe", "art/recipe.bmp", "copper_spoon", "art/spoon_copper.bmp",
                  "golden_ladle", "art/ladle_gold.bmp", "jacket", "art/jacket.bmp", "coat", "art/coat.bmp", "bag", "art/bag.bmp"]
    for i in range(0, len(images), 2) {
        if images[i] == kind { self.Sprite.image = images[i + 1] }
    }
    if price > 0 {
        label = spawn("prefabs/price.scene", vec2(0, 16), self)
        label.Label.text = "" + price
    }
    if on_clear or on_solve or game.hearts_max < min_hearts { show(false) }
}

func show(on: bool) -> void {
    shown = on
    if on { self.Sprite.tint = rgb(255, 255, 255) } else { self.Sprite.tint = rgb(255, 255, 255, 0) }
}

func visible() -> bool { return shown }

func update(dt: number) -> void {
    if game.state != "play" { return }
    if not shown {
        var ready := false
        if on_clear and len(find_all("Enemy")) == 0 and len(find_all("Spawner")) == 0 { ready = true }
        if on_solve and self.parent.solved { ready = true }
        if ready {
            show(true)
            play_sound("sfx/key.wav", 0.6)
        }
        return
    }
    if timeout > 0 {
        timeout -= dt
        if timeout < 2 and floor(timeout * 10) % 2 == 0 { self.Sprite.tint = rgb(255, 255, 255, 60) } else { self.Sprite.tint = rgb(255, 255, 255) }
        if timeout <= 0 {
            destroy(self)
            return
        }
    }
    if hero.touches(self.global_position, 3) { take() }
}

func take() -> void {
    if price > 0 {
        if game.beans < price { return }
        game.beans -= price
        play_sound("sfx/buy.wav")
    }
    if flag != "" { game.flag(flag) }
    game.collect(kind, self)
    destroy(self)
}
