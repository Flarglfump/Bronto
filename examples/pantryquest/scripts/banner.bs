# The name of where Pip has just come in ("LETTUCE WOODS", "THE PICKLE
# PANTRY"), on a red ribbon at the top of the play area. It shows when the
# name changes - not again for the next screen of the same woods - fades in,
# stays a moment, and fades away. While a cook is talking up there, it sits
# lower down. It also carries short notes ("GAME SAVED!"), the same way.

var last = ""
var t = 0
var shown = false
var y0 = 84
var left
var mid
var right
var text
var shadow
var game

func start() {
    game = find("Game")
    left = child(self, "BannerL")
    mid = child(self, "BannerMid")
    right = child(self, "BannerR")
    text = child(self, "BannerText")
    shadow = child(self, "BannerShadow")
}

# Pip has arrived somewhere called `name` ("" for nowhere in particular: a cave).
func arrive(name) {
    if name == "" or name == last { return }
    last = name
    put(name)
}

# A short note on the ribbon (it doesn't count as where Pip is).
func note(msg) { put(msg) }

func put(name) {
    text.Label.text = name
    shadow.Label.text = name
    var half = len(name) * 4 + 10                     # the ribbon fits the name
    mid.scale = vec2(half * 2 / 4, 1)
    left.x = -half - 6
    right.x = half + 6
    y0 = 84
    if game.say1 != "" { y0 = 124 }
    t = 0
    shown = true
}

func set_alpha(a) {
    var c = rgb(255, 255, 255, a * 255)
    left.Sprite.tint = c
    mid.Sprite.tint = c
    right.Sprite.tint = c
    text.Label.color = rgb(255, 240, 208, a * 255)
    shadow.Label.color = rgb(74, 20, 28, a * 255)
}

func update(dt) {
    if not shown { return }
    if game.state == "intro" {                          # a guardian is arriving: out of the way
        shown = false
        set_alpha(0)
        return
    }
    t += dt
    var a = 1
    if t < 0.3 { a = t / 0.3 }
    elif t > 2.6 { a = 1 - (t - 2.6) / 0.5 }
    if a <= 0 {
        shown = false
        set_alpha(0)
        return
    }
    self.position = vec2(128, y0 - (1 - min(1, t / 0.3)) * 6)
    set_alpha(a)
}
