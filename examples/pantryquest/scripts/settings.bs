# The player's settings, kept between runs as saved data ("settings"): how
# loud the music and the sounds are, the keys for each action - two keys
# each - and a gamepad button for each. Everything that reads the controls
# asks here: down("left"), pressed("spoon"). One "Settings" entity in
# title.scene and in main.scene runs this; scripts/settings_menu.bs changes it.
#
# Gamepads: the left stick and the d-pad always move (and choose in menus), A
# is always OK and B always back in menus. Whichever Pip was last played with
# - keys or a gamepad - is what the menus' hints name (using_pad).

var actions = ["up", "down", "left", "right", "spoon", "item", "pantry", "pause", "quicksave", "map", "item_next", "item_prev"]
var names = ["UP", "DOWN", "LEFT", "RIGHT", "SPOON", "ITEM (B)", "POCKET PANTRY", "PAUSE", "QUICK SAVE", "MAP",
             "NEXT ITEM", "PREVIOUS ITEM"]
var keys = []               # for each action, [first key, second key] ("" = none)
var pads = []               # for each action, a gamepad button ("" = none), as button_down() names them
var using_pad = false       # was a gamepad used last (rather than the keys or the mouse)?
var stick_on = [false, false, false, false]      # the left stick pushed up, down, left, right
var stick_hit = [false, false, false, false]     # ... just now (this step)
var music = 8               # 0 (off) to 10
var sounds = 10

func start() {
    load()
    apply()
}

func defaults() {
    keys = [["up", "w"], ["down", "s"], ["left", "a"], ["right", "d"],
            ["x", "space"], ["z", "j"], ["enter", "i"], ["escape", "p"],
            ["f5", ""], ["m", ""], ["e", ""], ["q", ""]]
    pads = ["up", "down", "left", "right", "a", "b", "x", "start", "back", "y", "rb", "lb"]
    music = 8
    sounds = 10
}

func load() {
    defaults()
    var d = load_data("settings")
    if d == nil or len(d) < 3 or len(d[0]) > len(actions) { return }
    var saved = d[0]                                   # (older settings have fewer actions: the new ones keep their own keys,
    for i in len(saved) {                              #  unless one of them was given away to an old action)
        keys[i] = saved[i]
    }
    for i in range(len(saved), len(actions)) {
        for w in 2 {
            for j in len(saved) {
                if keys[i][w] != "" and (saved[j][0] == keys[i][w] or saved[j][1] == keys[i][w]) { keys[i][w] = "" }
            }
        }
    }
    music = clamp(d[1], 0, 10)
    sounds = clamp(d[2], 0, 10)
    if len(d) >= 4 and len(d[3]) == len(actions) { pads = d[3] }    # (older settings have no buttons: the defaults)
}

func save() { save_data("settings", [keys, music, sounds, pads]) }

# Every step: the stick's directions (as buttons), and whether a gamepad or the keys were used last.
func update(dt) {
    var s = stick()
    var on = [s.y < -0.5, s.y > 0.5, s.x < -0.5, s.x > 0.5]
    for i in 4 {
        stick_hit[i] = on[i] and not stick_on[i]
        stick_on[i] = on[i]
    }
    if last_button() != "" or length(s) > 0.5 { using_pad = true }
    if last_key() != "" or mouse_pressed(0) { using_pad = false }
}

func dir_index(action) {
    var dirs = ["up", "down", "left", "right"]
    for i in 4 {
        if dirs[i] == action { return i }
    }
    return -1
}

func apply() {
    set_volume("music", music / 10)
    set_volume("sfx", sounds / 10)
    set_volume("ui", sounds / 10)
}

func index_of(action) {
    for i in len(actions) {
        if actions[i] == action { return i }
    }
    return -1
}

# Is a key or the button for this action held down / pressed this step? (The
# stick counts for the directions.)
func down(action) {
    var i = index_of(action)
    for k in keys[i] {
        if k != "" and key_down(k) { return true }
    }
    if pads[i] != "" and button_down(pads[i]) { return true }
    var d = dir_index(action)
    return d >= 0 and stick_on[d]
}
func pressed(action) {
    var i = index_of(action)
    for k in keys[i] {
        if k != "" and key_pressed(k) { return true }
    }
    if pads[i] != "" and button_pressed(pads[i]) { return true }
    var d = dir_index(action)
    return d >= 0 and stick_hit[d]
}

# Gives an action a gamepad button; a button does one thing, so it comes off any other action.
func set_pad(i, button) {
    for a in len(pads) {
        if pads[a] == button { pads[a] = "" }
    }
    pads[i] = button
}

# Gives an action a key (as its first or second, which = 0 or 1). A key does
# one thing only, so it comes off any other action that had it.
func set_key(i, which, key) {
    for a in len(keys) {
        for w in 2 {
            if keys[a][w] == key { keys[a][w] = "" }
        }
    }
    keys[i][which] = key
}

# Menus: the arrows always work, and so do the keys chosen for moving.
func nav(dir) {
    if dir == "ok" { return key_pressed("enter") or key_pressed("space") or pressed("spoon") or button_pressed("a") }
    if dir == "back" { return key_pressed("escape") or key_pressed("backspace") or button_pressed("b") }
    return key_pressed(dir) or pressed(dir) or button_pressed(dir)
}

# The other page (the Pocket Pantry's tabs): Tab, or a shoulder button.
func page() { return key_pressed("tab") or button_pressed("lb") or button_pressed("rb") }

# What the menus' hints call a control - the keys' or the gamepad's, whichever was used last.
func label_of(action) {
    var i = index_of(action)
    if using_pad { return pad_label(pads[i]) }
    return key_label(keys[i][0])
}
func ok_label() {
    if using_pad { return "A" }
    return "ENTER"
}
func back_label() {
    if using_pad { return "B" }
    return "ESC"
}
func page_label() {
    if using_pad { return "LB/RB" }
    return "TAB"
}
func choose_label() {
    if using_pad { return "STICK" }
    return "ARROWS"
}

# "lb" -> "LB", "up" -> "D-UP", "" -> "-": a gamepad button's name as the menus show it.
func pad_label(b) {
    if b == "" { return "-" }
    if b == "up" or b == "down" or b == "left" or b == "right" { return "D-" + upper(b) }
    return upper(b)
}

# ---- the mouse, in the menus ---------------------------------------------------------------
# Is the mouse over an entity (within `w` x `h` of its middle)? Over a label (its text)?
func over(e, w, h) {
    var m = mouse_position()
    var p = e.global_position
    return abs(m.x - p.x) <= w / 2 and abs(m.y - p.y) <= h / 2
}
func over_label(e) { return len(e.Label.text) > 0 and over(e, len(e.Label.text) * 8 + 6, 11) }
func clicked() { return mouse_pressed(0) }

# "space" -> "SPACE", "escape" -> "ESC", "" -> "-": a key's name as the menus show it (six letters at most).
func key_label(k) {
    if k == "" { return "-" }
    var long = ["escape", "backspace", "leftshift", "rightshift", "leftctrl", "rightctrl", "leftalt", "rightalt",
                "leftsuper", "rightsuper", "pageup", "pagedown", "delete", "insert"]
    var short = ["ESC", "BKSP", "LSHIFT", "RSHIFT", "LCTRL", "RCTRL", "LALT", "RALT", "LSUPER", "RSUPER", "PGUP", "PGDN", "DEL", "INS"]
    for i in len(long) {
        if long[i] == k { return short[i] }
    }
    return upper(k)
}

func upper(s) {
    var lo = "abcdefghijklmnopqrstuvwxyz"
    var hi = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    var out = ""
    for i in len(s) {
        var c = s[i]
        for j in 26 {
            if lo[j] == c {
                c = hi[j]
                break
            }
        }
        out += c
    }
    return out
}

# 3725 seconds -> "1:02:05": how long a file has been played.
func clock(t) {
    var h = floor(t / 3600)
    var m = floor(t / 60) % 60
    var sec = floor(t) % 60
    var mm = "" + m
    var ss = "" + sec
    if m < 10 { mm = "0" + mm }
    if sec < 10 { ss = "0" + ss }
    return h + ":" + mm + ":" + ss
}
