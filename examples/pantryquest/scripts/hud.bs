# The strip along the top: where Pip is (on the land, a little colour map of
# it - art/minimap.bmp, from tools/make_map.py - with the cellar doors he has
# found; in a cellar, its rooms, with the map and compass), his beans, keys
# and bombs, the items on B and A, and his hearts.

var game
var hearts = []
var bean_label
var key_label
var bomb_label
var b_item
var a_item
var dot
var map_box
var cells = []
var map_sig = ""            # what the cellar map was last drawn from
var boss_cell               # the compass's mark
var mini                    # the land's minimap
var marks = []              # the cellar doors on it
var marks_sig = ""
var t = 0

func start() {
    game = find("Game")
    for i in 16 {
        push(hearts, find("Heart" + i))
    }
    bean_label = find("BeanCount")
    key_label = find("KeyCount")
    bomb_label = find("BombCount")
    b_item = find("BItem")
    a_item = find("AItem")
    dot = find("MapDot")
    map_box = find("MapBox")
    mini = find("MiniMap")
}

func icon(item) {
    if item == "bombs" { return "art/bomb.bmp" }
    if item == "cutter" { return "art/cutter.bmp" }
    if item == "skewers" { return "art/skewer.bmp" }
    if item == "chili" { return "art/chili.bmp" }
    if item == "whisk" { return "art/whisk.bmp" }
    if item == "plank" { return "art/plank.bmp" }
    if item == "mitt" { return "art/mitt.bmp" }
    if item == "tray" { return "art/tray.bmp" }
    return ""
}

# Where a cellar room ("x_y") sits on the map.
func cell_pos(xy) {
    var p = game.split(xy, "_")
    return vec2(8 + num(p[0]) * 8 + 4 + 12, 16 + num(p[1]) * 6 + 3 + 1)
}

# A spot on the map of the land (in its pixels, a pixel a tile) on the minimap.
func mini_pos(spot) { return vec2(8 + spot.x / 4, 16 + spot.y * 4 / 11) }

# Is a cellar done? (Its page found; the Banquet Hall: the game won.)
func cleared(n) {
    if n == 9 { return game.has_flag("won") }
    return game.has_flag("page:d" + n)
}

# The doors of the cellars whose screens Pip has seen: red, or gold once cleared.
func draw_land_marks() {
    if game.state == "boot" { return }               # (the map's data starts after the HUD)
    var sig = len(game.land) + ":" + game.pages + ":" + game.has_flag("won")
    if sig == marks_sig { return }
    clear_marks()
    marks_sig = sig
    for d in find("MapData").doors() {
        if contains(game.land, d[3]) {
            var m = spawn("prefabs/map_mark.scene", mini_pos(vec2(d[1], d[2])))
            if cleared(d[0]) { m.Shape.color = rgb(255, 216, 74) } else { m.Shape.color = rgb(216, 52, 58) }
            push(marks, m)
        }
    }
}

func clear_marks() {
    for m in marks { destroy(m) }
    marks = []
    marks_sig = ""
}

func clear_cells() {
    for c in cells { destroy(c) }
    cells = []
    boss_cell = nil
}

# The cellar map: the rooms seen so far, or every room once Pip has the
# map (those not seen yet, dimmer); and with the compass, the guardian's
# room, blinking until it is beaten.
func draw_cellar_map() {
    var area = game.area
    var has_map = contains(game.maps, area)
    var has_compass = contains(game.compasses, area) and not game.has_flag("boss:" + area)
    var sig = area + ":" + len(game.visited) + ":" + has_map + ":" + has_compass
    if sig != map_sig {
        map_sig = sig
        clear_cells()
        var seen = []
        for name in game.visited {
            var p = game.split(name, "_")
            if p[0] == area { push(seen, p[1] + "_" + p[2]) }
        }
        var all = seen
        if has_map { all = find("Cellars").rooms(area) }
        for xy in all {
            var c = spawn("prefabs/map_cell.scene", cell_pos(xy))
            if not contains(seen, xy) { c.Shape.color = rgb(126, 92, 60) }
            push(cells, c)
        }
        if has_compass {
            boss_cell = spawn("prefabs/map_cell.scene", cell_pos(find("Cellars").boss_room(area)))
            boss_cell.Shape.size = vec2(3, 3)
            boss_cell.Shape.layer = 42
            push(cells, boss_cell)
        }
    }
    if boss_cell != nil {
        if floor(t * 3) % 2 == 0 { boss_cell.Shape.color = rgb(230, 60, 60) } else { boss_cell.Shape.color = rgb(120, 20, 20) }
    }
}

func update(dt) {
    bean_label.Label.text = "x" + game.beans
    key_label.Label.text = "x" + game.keys
    bomb_label.Label.text = "x" + game.bombs
    var b = icon(game.b_item)
    if b == "" { b_item.Sprite.tint = rgb(255, 255, 255, 0) } else {
        b_item.Sprite.image = b
        b_item.Sprite.tint = rgb(255, 255, 255)
    }
    a_item.Sprite.image = game.weapon_image()
    if game.weapon > 0 { a_item.Sprite.tint = rgb(255, 255, 255) } else { a_item.Sprite.tint = rgb(255, 255, 255, 0) }
    for i in 16 {
        var h = hearts[i]
        if i >= game.hearts_max {
            h.Sprite.tint = rgb(255, 255, 255, 0)
        } else {
            h.Sprite.tint = rgb(255, 255, 255)
            if game.hp >= (i + 1) * 2 { h.Sprite.image = "art/hud_heart_full.bmp" }
            elif game.hp > i * 2 { h.Sprite.image = "art/hud_heart_half.bmp" }    # (any part of a heart: a jacket or coat leaves quarters)
            else { h.Sprite.image = "art/hud_heart_empty.bmp" }
        }
    }
    # the map: the land is 16 x 8 screens in the 64 x 32 box (4 x 4 pixels a screen); a cellar, its rooms seen so far
    t += dt
    if game.area == "ow" or game.area == "cave" {
        mini.Sprite.tint = rgb(255, 255, 255)
        dot.position = mini_pos(game.map_spot())
        if floor(t * 4) % 2 == 0 { dot.Shape.color = rgb(255, 248, 236) } else { dot.Shape.color = rgb(216, 52, 58) }
        dot.Shape.size = vec2(3, 3)
        draw_land_marks()
    } else {
        mini.Sprite.tint = rgb(255, 255, 255, 0)
        clear_marks()
        dot.Shape.color = rgb(126, 224, 90)
        dot.Shape.size = vec2(4, 4)
        map_box.Shape.color = rgb(58, 38, 26)             # a cellar: dark chocolate
        dot.position = vec2(8 + game.rx * 8 + 4 + 12, 16 + game.ry * 6 + 3 + 1)
    }
    if game.area != "ow" and game.area != "cave" {
        draw_cellar_map()
    } elif len(cells) > 0 {
        clear_cells()
        map_sig = ""
    }
}
