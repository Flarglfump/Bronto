# Pantry Quest - the game itself: what Pip carries, where he is, and moving
# between rooms. One "Game" entity in main.scene runs this; everything else
# asks it (find("Game")).
#
# The world is made of rooms, each a scene file in rooms/: "ow_7_7" is the
# overworld room at column 7, row 7; "d1_2_4" a room of the first cellar;
# "cave_chef" a cave. A room is spawned at the top of the play area (y = 64,
# under the HUD); walking off its edge slides the next one in, and stairs
# and doorways fade to another room.

var hearts_max = 3          # heart containers
var hp = 6                  # in half hearts
var beans = 0
var keys = 0
var bombs = 0
var bombs_max = 8
var weapon = 0              # 0 none, 1 wooden spoon, 2 copper spoon, 3 silver ladle, 4 golden ladle (attack())
var outfit = 0              # 0 apron, 1 chef's jacket (hits hurt half as much), 2 royal coat (a quarter)
var hint_i = -1             # the upgrade the old chef told of last
var items = []              # "bombs", "cutter", "skewers", "chili", "whisk"
var treasures = []          # things carried that work by themselves: "plank", "mitt", "tray"
var b_item = ""             # the one on the B button (Z)
var pages = 0               # pages of the Grand Recipe
var flags = []              # what's been done: doors opened, items taken...
var visited = []            # cellar rooms seen (for the HUD map)
var land = []               # screens of the land Pip has been to ("x_y"): the pause map shows the rest in fog
var maps = []               # cellars whose map Pip has ("d1"...): the HUD shows every room
var compasses = []          # cellars whose compass he has: the HUD shows where the guardian is

var area = "ow"             # "ow", "cave", or a cellar: "d1", "d2"...
var rx = 7
var ry = 7
var room_name = ""
var room                    # the room's root entity
var map                     # its Tilemap
var state = "boot"          # boot, play, slide, fade_out, fade_in, hold, menu, pause, intro, dead, over, won
var start_room = "ow_7_7"   # (for testing a room in the editor: set these in Game's Script vars,
var start_items = ""        #  e.g. start_room = "d1_2_4", start_pos = vec2(128, 200), start_items = "bombs,cutter")
var start_pos := vec2(120, 168)
var area_start = "ow_7_7"   # where Continue goes after a game over
var area_pos := vec2(120, 168)

var hero
var fade
var next_room
var slide_dir := vec2(0, 0)
var slide_left = 0
var slide_total = 1
var hero_from := vec2(0, 0)
var hero_to := vec2(0, 0)
var fade_t = 0
var warp_name = ""
var warp_pos := vec2(0, 0)
var warp_face = "up"
var ret_name = ""           # where a cave's way out leads back to
var ret_pos := vec2(0, 0)
var cave_region = ""        # the region a cave opens onto (for the map)
var hold_t = 0
var dead_t = 0
var music_name = ""
var music
var say1 = ""
var say2 = ""
var say_t = 0
var beep_t = 0
var won_t = 0
var holding_page = false
var holding_recipe = false  # the Grand Recipe, whole: the end
var note1 = ""              # a message for when the next room has faded in
var note2 = ""
var whisk_i = -1            # the cellar door the whisk went to last (in the list of those with a page)

var booted = 0
var slot = 0                # the save slot being played (1 to 3), chosen on the title; 0: none (the editor's Play)
var play_time = 0           # seconds played in this slot
var controls                # the player's keys (the Settings entity)
var boss                    # the guardian in this room, once it has shown itself
var intro_t = 0             # how far into its entrance (state "intro")

func start() {
    hero = find("Hero")
    fade = find("Fade")
    controls = find("Settings")
    state = "boot"
}

# The first steps: every script in the scene has started before the first room comes in.
# The title leaves the chosen slot in saved data ("session"): a slot with a game
# in it carries on from where it was saved, an empty one starts a new game.
func boot() {
    booted += 1
    if booted < 2 { return }
    var chosen = load_data("session")
    if chosen != nil {
        delete_data("session")
        slot = chosen
        if has_data("slot" + slot) { load_game() }
    }
    for item in split(start_items, ",") {
        if item != "" { give(item) }
    }
    enter(start_room, start_pos, "up")
    state = "fade_in"
    fade_t = 0
    if slot > 0 and not has_data("slot" + slot) { save_game() }    # a new game: the file shows up straight away
}

# ---- saving -------------------------------------------------------------------------
# A slot is saved data "slot1" to "slot3": [name, value] pairs, so a later
# version can add things and still read old files.

# Where Pip carries on from: this screen on the land, outside a cave, or the
# door of the cellar he is in.
func resume_point() {
    if area == "ow" { return [room_name, hero.position] }
    if area == "cave" { return [ret_name, ret_pos] }
    return [area_start, area_pos]
}

func save_game() {
    if slot <= 0 { return false }
    var r = resume_point()
    var place = area_title()
    if place == "" { place = find("Banner").last }
    var data = [["version", 3], ["outfit", outfit], ["land", land], ["room", r[0]], ["pos", r[1]], ["place", place], ["time", floor(play_time)],
                ["hearts_max", hearts_max], ["beans", beans], ["keys", keys], ["bombs", bombs],
                ["bombs_max", bombs_max], ["weapon", weapon], ["items", items], ["b_item", b_item], ["treasures", treasures],
                ["pages", pages], ["flags", flags], ["visited", visited], ["maps", maps], ["compasses", compasses],
                ["area_start", area_start], ["area_pos", area_pos]]
    return save_data("slot" + slot, data)
}

func load_game() {
    var data = load_data("slot" + slot)
    if data == nil { return false }
    var version = 1
    var has_land = false
    for pair in data {
        var k = pair[0]
        var v = pair[1]
        if k == "version" { version = v }
        elif k == "outfit" { outfit = v }
        elif k == "land" {
            land = v
            has_land = true
        }
        elif k == "room" { start_room = v }
        elif k == "pos" { start_pos = v }
        elif k == "time" { play_time = v }
        elif k == "hearts_max" { hearts_max = v }
        elif k == "beans" { beans = v }
        elif k == "keys" { keys = v }
        elif k == "bombs" { bombs = v }
        elif k == "bombs_max" { bombs_max = v }
        elif k == "weapon" { weapon = v }
        elif k == "items" { items = v }
        elif k == "b_item" { b_item = v }
        elif k == "treasures" { treasures = v }
        elif k == "pages" { pages = v }
        elif k == "flags" { flags = v }
        elif k == "visited" { visited = v }
        elif k == "maps" { maps = v }
        elif k == "compasses" { compasses = v }
        elif k == "area_start" { area_start = v }
        elif k == "area_pos" { area_pos = v }
    }
    if version < 2 and weapon == 2 { weapon = 3 }      # (a first-version file: 2 was the silver ladle)
    if not has_land {                                  # (a file from before the map: no fog on it)
        for y in 8 {
            for x in 16 { push(land, x + "_" + y) }
        }
    }
    hp = hearts_max * 2
    return true
}

# How hard a poke hits, with the spoon or ladle Pip has.
func attack() {
    var power = [0, 1, 1.5, 2, 3]
    return power[clamp(weapon, 0, 4)]
}

# ---- rooms --------------------------------------------------------------------
func split(s, sep) {
    var out = []
    var cur = ""
    for i in len(s) {
        if s[i] == sep {
            push(out, cur)
            cur = ""
        } else {
            cur += s[i]
        }
    }
    push(out, cur)
    return out
}

func room_file(name) { return "rooms/" + name + ".scene" }

# The name for the banner as Pip comes in: the part of the land, or the cellar.
func area_title() {
    if area == "cave" { return "" }
    if room.title != "" { return room.title }
    if area == "ow" { return room.region }
    return find("Cellars").name(area)
}

# Makes `name` the current room (spawned at the top of the play area).
func enter(name, pos, face) {
    if room != nil { destroy(room) }
    room = spawn(room_file(name), vec2(0, 64))
    map = child(room, "Map")
    set_place(name)
    if area == "ow" {                               # where Continue goes after a game over:
        area_start = start_room                     # the overworld's start, or the cellar's door
        area_pos = start_pos
    } elif area != "cave" {
        area_start = name
        area_pos = pos
    }
    hero.position = pos
    hero.face(face)
    music_for_room()
    say("", "")
}

func set_place(name) {
    room_name = name
    if substr(name, 0, 4) == "cave" {
        area = "cave"
        return
    }
    var p = split(name, "_")
    area = p[0]
    rx = num(p[1])
    ry = num(p[2])
    if area != "ow" and not contains(visited, name) { push(visited, name) }
    if area == "ow" and not contains(land, p[1] + "_" + p[2]) { push(land, p[1] + "_" + p[2]) }
}

# Where Pip is on the map of the land (art/world_map.bmp, a pixel a tile): on
# the land, his very spot; in a cave, its mouth; in a cellar, its door.
func map_spot() {
    var name = room_name
    var pos = hero.position
    if area == "cave" {
        name = ret_name
        pos = ret_pos
    } elif area != "ow" {
        var c = find("Cellars")
        name = c.exit_room(area)
        pos = c.exit_pos(area)
    }
    var p = split(name, "_")
    if len(p) < 3 { return vec2(7 * 16 + 8, 7 * 11 + 6) }
    return vec2(num(p[1]) * 16 + pos.x / 16, num(p[2]) * 11 + (pos.y - 64) / 16)
}

# What the map calls where Pip is.
func place_name() {
    if area == "cave" {
        if cave_region == "" { return "IN A CAVE" }
        return "IN A CAVE, " + in_or_on(cave_region)
    }
    if area == "ow" { return in_or_on(room.region) }
    return "IN " + find("Cellars").name(area)
}

func in_or_on(region) {
    if region == "SUGAR ROAD" or region == "PANTRY PLAINS" or region == "JUICE COAST" { return "ON THE " + region }
    return "IN THE " + region
}

func music_for_room() {
    var want = room.music
    if want == "" { want = "none" }
    play_music(want)
}

# A track by name ("overworld", "cellar", "boss"...); a name starting with
# "none" just stops the music.
func play_music(name) {
    if name == music_name { return }
    music_name = name
    if music != nil { destroy(music) }
    music = nil
    if substr(name, 0, 4) != "none" { music = spawn("prefabs/music_" + name + ".scene", vec2(0, 0)) }
}

# The hero walked off the play area towards `side` ("n", "s", "e" or "w").
func leave(side) {
    if state != "play" { return }
    var ex = exit_of(side)
    if ex == "back" {
        warp(ret_name, ret_pos, "down")
        return
    }
    if ex != "" {
        warp(ex, room.exit_pos, room.exit_face)
        return
    }
    if area == "cave" { return }
    var d := vec2(0, 0)
    if side == "n" { d = vec2(0, -1) }
    if side == "s" { d = vec2(0, 1) }
    if side == "w" { d = vec2(-1, 0) }
    if side == "e" { d = vec2(1, 0) }
    var name = area + "_" + (rx + d.x) + "_" + (ry + d.y)
    next_room = spawn(room_file(name), vec2(d.x * 256, 64 + d.y * 176))
    slide_dir = d
    if d.x != 0 { slide_left = 256 } else { slide_left = 176 }
    slide_total = slide_left
    hero_from = hero.position
    hero_to = hero.position - d * slide_total          # the same place on the screen, then a few steps in
    # In the cellars he walks on past the doorway (two tiles deep), so that
    # a shutter closing behind him can't close on his feet.
    var deep = 0
    if area != "ow" { deep = 1 }
    if d.y < 0 { hero_to.y = min(hero_to.y, 232 - deep * 32) }      # arriving at the bottom: 200
    if d.y > 0 { hero_to.y = max(hero_to.y, 72 + deep * 24) }       # arriving at the top: 96
    if d.x < 0 { hero_to.x = min(hero_to.x, 240 - deep * 24) }      # arriving on the right: 216
    if d.x > 0 { hero_to.x = max(hero_to.x, 16 + deep * 24) }       # arriving on the left: 40
    state = "slide"
    set_place(name)
    say("", "")
}

func exit_of(side) {
    if side == "n" { return room.exit_n }
    if side == "s" { return room.exit_s }
    if side == "e" { return room.exit_e }
    return room.exit_w
}

func warp(name, pos, face) {
    if state != "play" and state != "hold" { return }
    if substr(name, 0, 4) == "cave" and area != "cave" {
        ret_name = room_name
        ret_pos = hero.position + vec2(0, 16)
        cave_region = room.region
    }
    warp_name = name
    warp_pos = pos
    warp_face = face
    state = "fade_out"
    fade_t = 0
    play_sound("sfx/stairs.wav", 0.6)
}

func update(dt) {
    if state == "boot" {
        boot()
    } elif state == "slide" {
        var step = min(4, slide_left)
        slide_left -= step
        room.position -= slide_dir * step
        next_room.position -= slide_dir * step
        hero.position = lerp(hero_from - slide_dir * (slide_total - slide_left), hero_to, 1 - slide_left / slide_total)
        if slide_left <= 0 {
            destroy(room)
            room = next_room
            next_room = nil
            room.position = vec2(0, 64)
            map = child(room, "Map")
            hero.position = hero_to
            state = "play"
            music_for_room()
            room.entered()
            find("Banner").arrive(area_title())
        }
    } elif state == "fade_out" {
        fade_t += dt
        set_fade(fade_t / 0.3)
        if fade_t >= 0.3 {
            enter(warp_name, warp_pos, warp_face)
            state = "fade_in"
            fade_t = 0
        }
    } elif state == "fade_in" {
        fade_t += dt
        set_fade(1 - fade_t / 0.3)
        if fade_t >= 0.3 {
            set_fade(0)
            state = "play"
            room.entered()
            if note1 != "" {
                say(note1, note2)
                note1 = ""
            }
            find("Banner").arrive(area_title())
        }
    } elif state == "hold" {
        hold_t -= dt
        if hold_t <= 0 {
            hero.hold_done()
            state = "play"
            after_hold()
        }
    } elif state == "dead" {
        dead_t += dt
        hero.spin(dead_t)
        if dead_t > 2.2 {
            state = "over"
            set_fade(0.85)
            spawn("prefabs/game_over.scene", vec2(128, 152))
            play_sound("sfx/game_over.wav")
        }
    } elif state == "play" {
        if controls.pressed("pantry") {
            state = "menu"
            spawn("prefabs/menu.scene", vec2(128, 152))
            play_sound("sfx/menu.wav")
        } elif controls.pressed("pause") or key_pressed("escape") {      # (Escape always pauses)
            state = "pause"
            spawn("prefabs/pause_menu.scene", vec2(128, 152))
            play_sound("sfx/menu.wav")
        }
        if hp <= 2 and hp > 0 {
            beep_t -= dt
            if beep_t <= 0 {
                play_sound("sfx/low_health.wav", 0.5)
                beep_t = 0.9
            }
        }
    } elif state == "intro" {
        intro(dt)
    } elif state == "won" {
        won_t += dt
    }
    if state != "pause" and state != "menu" and state != "over" and state != "boot" { play_time += dt }
    type_text(dt)
}

func set_fade(a) {
    fade.Shape.color = rgb(0, 0, 0, clamp(a, 0, 1) * 255)
}

# ---- the hero's health ------------------------------------------------------------
func damage(half_hearts) {
    var guard = [1, 0.5, 0.25]
    hp -= half_hearts * guard[clamp(outfit, 0, 2)]
    play_sound("sfx/hurt.wav")
    if hp <= 0 {
        hp = 0
        state = "dead"
        dead_t = 0
        play_music("none_dead")
    }
}

func continue_game() {
    hp = 6
    for e in find_all("GameOver") { destroy(e) }
    set_fade(1)
    music_name = ""
    enter(area_start, area_pos, "up")
    state = "fade_in"
    fade_t = 0
}

func heal(half_hearts) {
    hp = min(hp + half_hearts, hearts_max * 2)
}

# ---- flags --------------------------------------------------------------------------
func flag(f) {
    if not contains(flags, f) { push(flags, f) }
}
func has_flag(f) { return contains(flags, f) }

# ---- things to pick up -----------------------------------------------------------------
func collect(kind, thing) {
    if kind == "bean" {
        beans = min(beans + 1, 255)
        play_sound("sfx/bean.wav")
    } elif kind == "bean5" {
        beans = min(beans + 5, 255)
        play_sound("sfx/bean.wav")
    } elif kind == "heart" {
        heal(2)
        play_sound("sfx/heart.wav")
    } elif kind == "soup" {
        heal(hearts_max * 2)
        play_sound("sfx/heart.wav")
    } elif kind == "key" {
        keys += 1
        play_sound("sfx/key.wav")
    } elif kind == "bomb" {
        give("bombs")
        bombs = min(bombs + 4, bombs_max)
        play_sound("sfx/key.wav")
    } elif kind == "bombs_item" {
        give("bombs")
        bombs = min(bombs + 4, bombs_max)
        hold("art/bomb.bmp", 1.2)
    } elif kind == "spoon" {
        weapon = max(weapon, 1)
        hold("art/spoon.bmp", 1.6)
    } elif kind == "copper_spoon" {
        weapon = max(weapon, 2)
        hold("art/spoon_copper.bmp", 1.6)
    } elif kind == "golden_ladle" {
        weapon = max(weapon, 4)
        hold("art/ladle_gold.bmp", 1.6)
    } elif kind == "jacket" {
        outfit = max(outfit, 1)
        hold("art/jacket.bmp", 1.6)
    } elif kind == "coat" {
        outfit = max(outfit, 2)
        hold("art/coat.bmp", 1.6)
    } elif kind == "cutter" {
        give("cutter")
        b_item = "cutter"
        hold("art/cutter.bmp", 1.6)
    } elif kind == "map" {
        if not contains(maps, area) { push(maps, area) }
        hold("art/dmap.bmp", 1.2)
    } elif kind == "compass" {
        if not contains(compasses, area) { push(compasses, area) }
        hold("art/compass.bmp", 1.2)
    } elif kind == "skewers" {
        give("skewers")
        b_item = "skewers"
        hold("art/skewer.bmp", 1.6)
    } elif kind == "chili" {
        give("chili")
        b_item = "chili"
        hold("art/chili.bmp", 1.6)
    } elif kind == "plank" {
        if not contains(treasures, "plank") { push(treasures, "plank") }
        hold("art/plank.bmp", 1.6)
    } elif kind == "mitt" or kind == "tray" {
        if not contains(treasures, kind) { push(treasures, kind) }
        hold("art/" + kind + ".bmp", 1.6)
    } elif kind == "ladle" {
        weapon = max(weapon, 3)
        hold("art/ladle.bmp", 1.6)
    } elif kind == "whisk" {
        give("whisk")
        b_item = "whisk"
        hold("art/whisk.bmp", 1.6)
    } elif kind == "heart_pie" {
        hearts_max = min(hearts_max + 1, 16)
        hp = hearts_max * 2
        hold("art/heart_pie.bmp", 1.6)
    } elif kind == "recipe" {
        hold("art/recipe.bmp", 3.0)
        play_music("none_recipe")
        play_sound("sfx/page.wav")
        holding_recipe = true
    } elif kind == "page" {
        pages += 1
        hold("art/page.bmp", 3.0)
        play_music("none_page")
        play_sound("sfx/page.wav")
        holding_page = true
    }
}
func has_treasure(t) { return contains(treasures, t) }

# The whisk: out on the land, it whirls Pip off to a cellar door - each use,
# the next cellar whose recipe page he has. Anywhere else it just spins.
func whisk() {
    var places = []
    for n in range(1, 10) {
        if has_flag("page:d" + n) { push(places, "d" + n) }
    }
    if area != "ow" or len(places) == 0 {
        play_sound("sfx/tink.wav", 0.6)
        return false
    }
    whisk_i = (whisk_i + 1) % len(places)
    var c = find("Cellars")
    var a = places[whisk_i]
    spawn("prefabs/whirl.scene", hero.position)
    play_sound("sfx/whisk.wav")
    warp(c.exit_room(a), c.exit_pos(a), "down")
    return true
}

# The picture of Pip's spoon or ladle (for his hand and the HUD).
func weapon_image() {
    var images = ["art/spoon.bmp", "art/spoon.bmp", "art/spoon_copper.bmp", "art/ladle.bmp", "art/ladle_gold.bmp"]
    return images[clamp(weapon, 0, 4)]
}

# ---- hints (the old chef in the first cave: scripts/hint.bs) ------------------------
# The next cellar to clear (the first whose page Pip hasn't found), and how to find it.
func hint_next() {
    var data = find("Hints")
    if has_flag("won") { return ["THE KINGDOM IS FED! GO AND", "EXPLORE, LITTLE CHEF."] }
    for n in range(1, 9) {
        if not has_flag("page:d" + n) {
            var h = data.cellar(n)
            if h[2] and not contains(items, "bombs") { return ["FIRST, GET POPCORN BOMBS:", "THE SHOPS SELL THEM."] }
            return [h[0], h[1]]
        }
    }
    var last = data.cellar(9)
    return [last[0], last[1]]
}

# One upgrade out in the land Pip can reach now (and hasn't taken): a
# different one each time he asks.
func hint_upgrade() {
    var open = []
    var left = 0
    for u in find("Hints").upgrades() {
        if not has_flag(u[0]) {
            left += 1
            var can = hearts_max >= u[2]
            if u[1] == "bombs" and not contains(items, "bombs") { can = false }
            if u[1] == "fire" and not contains(items, "bombs") and not contains(items, "chili") { can = false }
            if can { push(open, u) }
        }
    }
    if left == 0 { return ["YOU'VE FOUND EVERY UPGRADE", "OUT THERE. WELL DONE!"] }
    if len(open) == 0 { return ["NOTHING YOU CAN REACH YET.", "COME BACK STRONGER!"] }
    hint_i = (hint_i + 1) % len(open)
    return [open[hint_i][3], open[hint_i][4]]
}

func give(item) {
    if not contains(items, item) {
        push(items, item)
        if b_item == "" { b_item = item }
    }
}

func hold(image, seconds) {
    state = "hold"
    hold_t = seconds
    hero.hold(image)
    if image != "art/page.bmp" { play_sound("sfx/item.wav") }
}

func after_hold() {
    if holding_recipe {
        holding_recipe = false
        win()
        return
    }
    if holding_page {
        holding_page = false
        flag("page:" + area)
        note1 = "RECIPE PAGE " + pages + " OF 8 FOUND!"
        note2 = "NOW FIND THE NEXT CELLAR!"
        if pages >= 8 { note2 = "THE BARON'S HALL ISN'T DUG YET" }
        area_start = start_room
        area_pos = start_pos
        var cellars = find("Cellars")                       # back out of this cellar's door
        warp(cellars.exit_room(area), cellars.exit_pos(area), "down")
        music_name = ""
    }
}

# The end: the Grand Recipe is whole. The file is saved (marked as won,
# carrying on from the Banquet Hall's door), and the ending card comes up.
func win() {
    flag("won")
    state = "won"
    won_t = 0
    save_game()
    set_fade(0.6)
    play_music("title")
    spawn("prefabs/ending.scene", vec2(128, 152))
}

# ---- how tough things are, by stage ------------------------------------------------
# A room's `tier` is its stage of the game (scripts/room.bs). Ordinary enemies
# and everything enemies throw get tougher with it - to keep up with the
# spoons and ladles, jackets and heart pies Pip finds along the way. (The
# guardians are tuned one by one, for the spoon or ladle Pip is likely to
# carry by then; only their touch and throws scale.) Health keeps pace with
# the spoons and ladles, damage with the heart pies and the chef's jacket -
# the royal coat stays a real reward. (Stage 7 stays at x2: the Sugar Mill's
# spice and sugar get past the pot lid until its own baking tray is found.)
#
#   stage      1    2    3    4    5    6    7    8    9
#   health    x1   x1  x1.5 x1.5  x2   x2  x2.5  x3  x3.5   (rounded up)
#   damage    x1   x1   x1  x1.5  x2   x2   x2   x3   x3    (rounded up)
func stage_of(room) {
    if room == nil or not room.alive or room.name != "Room" { return 0 }
    return clamp(room.tier, 0, 9)
}
func enemy_hp(base, room) {
    var mult = [1, 1, 1, 1.5, 1.5, 2, 2, 2.5, 3, 3.5]
    return ceil(base * mult[stage_of(room)])
}
func enemy_damage(base, room) {
    var mult = [1, 1, 1, 1, 1.5, 2, 2, 2, 3, 3]
    return ceil(base * mult[stage_of(room)])
}

# Something an enemy might leave behind.
func drop_at(local_pos, parent) {
    var r = random()
    var kind = ""
    if r < 0.28 { kind = "bean" }
    elif r < 0.34 { kind = "bean5" }
    elif r < 0.46 { kind = "heart" }
    elif r < 0.52 and contains(items, "bombs") { kind = "bomb" }
    if kind == "" { return }
    var p = spawn("prefabs/pickup.scene", open_spot(local_pos, parent), parent)
    p.kind = kind
    p.timeout = 9
}

# The nearest spot on open floor to a point in a room (a bat shot down over a crate or
# the jam drops its bean beside it, where Pip can reach it - not on top of it).
func open_spot(local_pos, parent) {
    var m = child(parent, "Map")
    var origin = parent.global_position
    var cell = vec2(floor(local_pos.x / 16), floor(local_pos.y / 16))
    if not tile_solid(m, origin + cell * 16 + vec2(8, 8)) { return local_pos }
    for k in range(1, 4) {
        for dy in range(-k, k + 1) {
            for dx in range(-k, k + 1) {
                var c = cell + vec2(dx, dy)
                if c.x >= 1 and c.x <= 14 and c.y >= 1 and c.y <= 9 and not tile_solid(m, origin + c * 16 + vec2(8, 8)) {
                    return c * 16 + vec2(8, 8)
                }
            }
        }
    }
    return local_pos
}

# ---- a guardian's entrance ---------------------------------------------------------
# Its script calls this the first moment it can (its room has come in). The
# game waits while bars close in, the guardian swells into view and roars,
# and its name comes in on a card (scripts/boss_ui.bs draws those); Enter,
# X or Space skips the rest after the first second.
func boss_arrives(b) {
    boss = b
    state = "intro"
    intro_t = 0
    play_music("none_intro")
    b.Sprite.tint = rgb(255, 255, 255, 0)
}

func intro(dt) {
    var before = intro_t
    intro_t += dt
    if boss == nil or not boss.alive {
        state = "play"
        return
    }
    var t = intro_t
    if t >= 0.4 and t < 1.3 {                          # it swells into view, wobbling
        var k = (t - 0.4) / 0.9
        boss.Sprite.tint = rgb(255, 255, 255, min(1, k * 1.6) * 255)
        boss.scale = 1 + (1 - k) * 0.7 + sin(k * 540) * 0.12 * (1 - k)
    }
    if before < 1.3 and t >= 1.3 {
        boss.scale = 1
        boss.Sprite.tint = rgb(255, 255, 255)
        play_sound("sfx/roar.wav")
        play_music("boss")
    }
    if t > 1.0 and (controls.nav("ok") or controls.pressed("pantry")) and t < 3.0 {
        intro_t = 3.0                                  # skip to the end
        boss.scale = 1
        boss.Sprite.tint = rgb(255, 255, 255)
        if before < 1.3 {
            play_sound("sfx/roar.wav")
            play_music("boss")
        }
    }
    if intro_t >= 3.4 {
        state = "play"
        boss.intro_done()
    }
}

# A cellar's guardian is beaten (its script calls this as it goes).
func boss_beaten() {
    flag("boss:" + area)
    play_music("cellar")
}

func enemy_killed(e) {
    play_sound("sfx/enemy_die.wav")
    spawn("prefabs/puff.scene", e.position, e.parent)
    drop_at(e.position, e.parent)
}

# ---- the message at the top of a cave -------------------------------------------------
func say(a, b) {
    say1 = a
    say2 = b
    say_t = 0
    find("Say1").Label.text = ""
    find("Say2").Label.text = ""
}

func type_text(dt) {
    if say1 == "" and say2 == "" { return }
    var total = len(say1) + len(say2)
    var before = floor(say_t * 20)
    say_t += dt
    var shown = min(floor(say_t * 20), total)
    if shown == before or before >= total { return }
    find("Say1").Label.text = substr(say1, 0, shown)
    find("Say2").Label.text = substr(say2, 0, max(0, shown - len(say1)))
    if shown % 2 == 0 { play_sound("sfx/text.wav", 0.4) }
}

# ---- doors -----------------------------------------------------------------------------
# The cells of each side's doorway in a cellar room.
func door_cells(side) {
    if side == "n" { return [vec2(7, 0), vec2(8, 0), vec2(7, 1), vec2(8, 1)] }
    if side == "s" { return [vec2(7, 9), vec2(8, 9), vec2(7, 10), vec2(8, 10)] }
    if side == "w" { return [vec2(0, 5), vec2(1, 5)] }
    return [vec2(14, 5), vec2(15, 5)]
}

func cell_point(c) { return room.global_position + vec2(c.x * 16 + 8, c.y * 16 + 8) }

func set_door(side, tile) {
    for c in door_cells(side) { set_tile(map, cell_point(c), tile) }
}

func opposite(side) {
    if side == "n" { return "s" }
    if side == "s" { return "n" }
    if side == "e" { return "w" }
    return "e"
}

func neighbour(side) {
    var x = rx
    var y = ry
    if side == "n" { y -= 1 }
    if side == "s" { y += 1 }
    if side == "w" { x -= 1 }
    if side == "e" { x += 1 }
    return area + "_" + x + "_" + y
}

# Opens a doorway for good: this room's side, and the other room's matching side.
func open_door(side) {
    set_door(side, ",")
    flag("open:" + room_name + ":" + side)
    flag("open:" + neighbour(side) + ":" + opposite(side))
}

func side_of_cell(col, row) {
    if row <= 1 { return "n" }
    if row >= 9 { return "s" }
    if col <= 1 { return "w" }
    return "e"
}

# The hero pushed against a locked door at a world point.
func try_unlock(point) {
    if keys <= 0 { return false }
    var local = point - room.global_position
    keys -= 1
    open_door(side_of_cell(floor(local.x / 16), floor(local.y / 16)))
    play_sound("sfx/door.wav")
    return true
}

# The fire chili burned at a world point: a bush hiding a way in (tile Y) burns away.
func burn(point) {
    for w in find_all("Warp") {
        if w.hidden and distance(w.global_position, point) < 20 and tile_at(map, w.global_position) == "Y" { w.reveal() }
    }
}

# A bomb went off at a world point: secret walls nearby open.
func blast(point) {
    for w in find_all("Warp") {
        if distance(w.global_position, point) < 28 { w.reveal() }
    }
    if area == "ow" or area == "cave" { return }
    for dx in [-16, 0, 16] {
        for dy in [-16, 0, 16] {
            var p = point + vec2(dx, dy)
            if tile_at(map, p) == "X" {
                var local = p - room.global_position
                open_door(side_of_cell(floor(local.x / 16), floor(local.y / 16)))
                play_sound("sfx/secret.wav")
                return
            }
        }
    }
}
