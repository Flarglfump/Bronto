# Pantry Quest - a breadstick soldier (spawned in rooms; tools/make_rooms.py copies it into room scenes)
bronto_scene 1

entity
  Name
    text = "Enemy"
  Transform
    position = 0 0
  Sprite
    image = "art/breadstick_0.bmp"
    layer = 3
  Script
    file = "scripts/enemies/walker.bs"
    vars = "hp = 2, damage = 2, image = \"art/breadstick_\", speed = 34"
