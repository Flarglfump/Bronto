# Pantry Quest - a burger knight: throws toothpicks when Pip lines up (spawned in rooms; tools/make_rooms.py copies it into room scenes)
bronto_scene 1

entity
  Name
    text = "Enemy"
  Transform
    position = 0 0
  Sprite
    image = "art/burger_0.bmp"
    layer = 3
  Script
    file = "scripts/enemies/walker.bs"
    vars = "hp = 2, damage = 1, image = \"art/burger_\", shot = \"prefabs/toothpick.scene\", aim = true, shot_speed = 140, speed = 26"
