# Pantry Quest - a plum: tougher, spits seeds more often (spawned in rooms; tools/make_rooms.py copies it into room scenes)
bronto_scene 1

entity
  Name
    text = "Enemy"
  Transform
    position = 0 0
  Sprite
    image = "art/plum_0.bmp"
    layer = 3
  Script
    file = "scripts/enemies/walker.bs"
    vars = "hp = 2, image = \"art/plum_\", shot = \"prefabs/seed.scene\", shot_chance = 0.4, speed = 36"
