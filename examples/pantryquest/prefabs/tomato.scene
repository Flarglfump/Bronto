# Pantry Quest - a tomato: walks, spits seeds (spawned in rooms; tools/make_rooms.py copies it into room scenes)
bronto_scene 1

entity
  Name
    text = "Enemy"
  Transform
    position = 0 0
  Sprite
    image = "art/tomato_0.bmp"
    layer = 3
  Script
    file = "scripts/enemies/walker.bs"
    vars = "image = \"art/tomato_\", shot = \"prefabs/seed.scene\""
