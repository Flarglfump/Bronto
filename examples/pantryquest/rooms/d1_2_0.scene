    position = 0 64
  Script
    file = "scripts/room.bs"
    vars = "id = \"d1_2_0\", music = \"cellar\", stays_clear = true"

entity
  Name
    text = "Map"
  Transform
    position = 128 88
  Tilemap
    tileset = "art/tiles_dungeon.bmp"
    tile_size = 16
    columns = 16
    rows = 11
    legend = ".#O~SLHXPV,"
    solid = "#O~LHXPV"
    tiles = "##################################............####............####.....PP.....####............####............####............####............#########,,##############,,#######"
    layer = -10
