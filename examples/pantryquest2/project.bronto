bronto_project 1
# Pantry Quest II: Castle Fromage - an adventure under the Pantry Kingdom. Open this folder in the editor.
name = Pantry Quest II
main_scene = title.scene
width = 256
height = 240
window_scale = 3
# every script must declare its types (as if each began with @strict)
strict_typing = true
# on a phone or tablet (the web build): an on-screen stick and buttons, which work as a gamepad
touch_controls = stick, a, x, b, y, back, start
# the tools that make the art, sounds and rooms aren't part of the game
exclude = tools
