@strict
# A signpost: its words show while Basil stands by it ('|' starts a new line).

var text: string = ""
var draw_layer: int = 55
var basil: entity
var near: bool = false

func start() -> void { basil = find("Basil") }

func update(dt: number) -> void {
    near = abs(basil.x - self.x) < 28 and abs(basil.y - self.y) < 40 and find("Game").state == "play"
}

func draw() -> void {
    if not near { return }
    var lines: list[string] = []
    var line: string = ""
    for i in len(text) {
        if text[i] == "|" {
            push(lines, line)
            line = ""
        } else {
            line = line + text[i]
        }
    }
    push(lines, line)
    var w: number = 0
    for l in lines { w = max(w, text_size(l).x) }
    var top: number = 30
    draw_rect(vec2(128 - w / 2 - 6, top - 4), vec2(w + 12, len(lines) * 10 + 6), rgb(30, 20, 10, 220))
    draw_rect(vec2(128 - w / 2 - 6, top - 4), vec2(w + 12, len(lines) * 10 + 6), "#c09060", false)
    for i in len(lines) { draw_text(lines[i], vec2(128 - text_size(lines[i]).x / 2, top + i * 10), "#f8e8c0") }
}
