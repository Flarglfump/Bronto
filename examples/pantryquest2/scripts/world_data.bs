func areas() -> list {
    # [area, title, map colour]
    return [
        ["village", "CRUMB VILLAGE", rgb(110, 100, 170)],
        ["catacombs", "RYE CATACOMBS", rgb(170, 110, 60)],
        ["frost", "FROSTBITE CELLAR", rgb(90, 160, 220)],
        ["molten", "MOLTEN KITCHENS", rgb(220, 90, 50)],
        ["brine", "BRINE WORKS", rgb(90, 170, 100)],
        ["castle", "CASTLE FROMAGE", rgb(200, 170, 70)]
    ]
}

