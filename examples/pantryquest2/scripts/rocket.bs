@strict
# A hot sauce rocket: fast, strong, and the only thing that melts a wax seal (a door or
# a block). It bursts on whatever it hits.

var dir := vec2(1, 0)
var speed: number = 2
var map: entity

func launch(d: vec2) -> void {
    dir = d
    map = find("Basil").map
    if dir.x < 0 {                                   # (the picture points right: flipped, it points left)
        self.Sprite.flip_x = true
        self.rotation = -angle(vec2(-dir.x, dir.y))
    } else {
        self.rotation = angle(dir)
    }
}

func update(dt: number) -> void {
    speed = min(speed + 0.5, 6.5)
    for i in 3 {
        self.position = self.position + dir * (speed / 3)
        if hit_something() {
            burst()
            return
        }
    }
    var size: vec2 = find("Game").room_size()
    if self.x < -16 or self.y < -16 or self.x > size.x + 16 or self.y > size.y + 16 { destroy(self) }
}

func hit_something() -> bool {
    var p := self.position
    var t := tile_at(map, p)
    if t == "Y" {
        for d in find_tagged("door") {
            if distance(d.position, p) < 30 and d.shot("rocket") { return true }
        }
    }
    if t == "r" or t == "c" {
        var cell := tile_cell(map, p)
        tile_put(map, cell.x, cell.y, ".")
        find("Game").room.broke(cell.x, cell.y, t)
        if t == "r" { find("Game").set_flag("block:" + find("Game").room_id + ":" + cell.x + "_" + cell.y) }
        spawn("prefabs/crumbs.scene", tile_cell_center(map, cell.x, cell.y))
        return true
    }
    for e in find_tagged("enemy") {
        if e.alive and e.hit_by(p, 4) {
            if e.hit(8, "rocket", dir) { return true }
        }
    }
    return tile_solid(map, p)
}

func burst() -> void {
    spawn("prefabs/blast.scene", self.position)
    play_sound("sfx/blast.wav", 0.7)
    shake_camera(2, 0.15)
    destroy(self)
}
