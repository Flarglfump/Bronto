@strict
# The story so far, before a new journey: a few pictures with words typed out under them.
# Jump (or fire, or Enter) shows the rest of a page, then turns it; PAUSE skips to the game.

var draw_layer: int = 60
var page: int = 0
var shown: number = 0
var t: number = 0                         # seconds on this page
var leaving: number = -1
var lines: list[string] = []

# Each page: [backdrop, who to show ("" none, or a portrait frame number), the words].
var pages: list = [
    ["art/title_empty.bmp", -1, "CRUMB VILLAGE: A TOWN OF BAKERS, ASLEEP UNDER AN EMPTY HILL."],
    ["art/title_night.bmp", -1, "ONE NIGHT, UNDER A FULL CHEESE MOON, A CASTLE ROSE WHERE NO CASTLE HAD EVER BEEN."],
    ["art/title_night.bmp", 3, "IN IT WAITED COUNT FROMAGE: A BLUE CHEESE OF TERRIBLE AGE, HUNGRY FOR THE GREATEST COOK IN ALL THE PANTRY."],
    ["art/title_night.bmp", 2, "BY MORNING, CHEF PIP WAS GONE. ONLY HIS HAT WAS LEFT, ON THE BAKERY STEP."],
    ["art/title_night.bmp", 0, "SO HIS APPRENTICE, BASIL, PUT ON A POT FOR A HELMET, TOOK UP THE OLD PEPPER MILL..."],
    ["art/title_night.bmp", -2, "...AND WENT TO BRING HIM HOME."]
]

func start() -> void {
    open_page()
}

func open_page() -> void {
    lines = wrap(pages[page][2], 28)
    shown = 0
    t = 0
}

func wrap(words: string, width: int) -> list[string] {
    var out: list[string] = []
    var line: string = ""
    var word: string = ""
    for i in len(words) + 1 {
        var c: string = " "
        if i < len(words) { c = words[i] }
        if c == " " or c == "|" {
            if word != "" {
                if line != "" and len(line) + len(word) + 1 > width {
                    push(out, line)
                    line = word
                } elif line == "" {
                    line = word
                } else {
                    line = line + " " + word
                }
            }
            word = ""
            if c == "|" {
                push(out, line)
                line = ""
            }
        } else {
            word = word + c
        }
    }
    if line != "" { push(out, line) }
    return out
}

func total() -> int {
    var n: int = 0
    for l in lines { n += len(l) }
    return n
}

func leave() -> void {
    if leaving >= 0 { return }
    leaving = 0
    stop_music(0.8)
}

func update(dt: number) -> void {
    t += dt
    if leaving >= 0 {
        leaving += dt
        if leaving > 0.9 { load_scene("main.scene") }
        return
    }
    var before: int = floor(shown)
    if t > 0.6 { shown = min(shown + dt * 30, total()) }
    if floor(shown) != before and floor(shown) % 3 == 0 { play_sound("sfx/text.wav", 0.3) }
    if action_pressed("ui_cancel") or action_pressed("pause") {
        leave()
        return
    }
    if action_pressed("ui_confirm") or mouse_pressed(0) {
        if shown < total() {
            shown = total()
        } else {
            page += 1
            play_sound("sfx/blip.wav", 0.5)
            if page >= len(pages) {
                page = len(pages) - 1
                leave()
            } else {
                open_page()
            }
        }
    }
}

func draw() -> void {
    var p: list = pages[page]
    draw_image(p[0], vec2(128, 120))
    var who: int = p[1]
    if who >= 0 {                                         # a portrait, framed, over the sky
        draw_rect(vec2(104, 50), vec2(48, 48), "#000000")
        draw_rect(vec2(105, 51), vec2(46, 46), "#f8e8b0", false)
        draw_rect(vec2(107, 53), vec2(42, 42), "#302030")
        draw_image("art/portraits.bmp", vec2(128, 74), who, vec2(32, 32))
    }
    if who == -2 {                                        # Basil, setting out (his run, on the spot)
        var f: int = 1 + floor(t * 10) % 4
        draw_image("art/basil.bmp", vec2(128, 190), f, vec2(24, 32))
    }
    var a: number = clamp(1 - t * 2, 0, 1)                # each page fades in
    draw_rect(vec2(0, 150), vec2(256, 90), rgb(0, 0, 0, 200))
    var left: int = floor(shown)
    var y: number = 162
    for l in lines {
        if left <= 0 { break }
        draw_text(substr(l, 0, left), vec2(16, y), "#ffffff")
        left -= len(l)
        y += 12
    }
    if shown >= total() and floor(t * 3) % 2 == 0 { draw_text(">", vec2(236, 222), "#f8c860") }
    draw_text("ESC: SKIP", vec2(4, 229), "#605070")
    if a > 0 { draw_rect(vec2(0, 0), vec2(256, 240), rgb(0, 0, 0, 255 * a)) }
    if leaving >= 0 { draw_rect(vec2(0, 0), vec2(256, 240), rgb(0, 0, 0, 255 * clamp(leaving / 0.8, 0, 1))) }
}
