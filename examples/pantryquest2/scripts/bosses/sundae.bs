@strict
# THE ABOMINABLE SUNDAE: ice cream melted and frozen and melted again for a hundred years,
# until it forgot it was ever sweet. It hurls scoops, stomps to bring icicles down, and curls
# into a ball to roll across its den (rolling, nothing hurts it). Frost Sugar slows it.

const NAME: string = "ABOMINABLE SUNDAE"
const HP: number = 60
var home := vec2(0, 0)
var game: entity
var basil: entity
var state: string = "sleep"               # sleep, intro, idle, throw, stomp, roll, dying
var hp: number = 60
var t: number = 0
var vel := vec2(0, 0)
var facing: int = -1
var flash_t: number = 0
var chill_t: number = 0
var moves: int = 0
var bounces: int = 0
var ground: number = 0
var right_wall: number = 480

func start() -> void {
    game = find("Game")
    basil = find("Basil")
    ground = self.y
    right_wall = game.room_size().x - 36
    if game.flag("boss:sundae") {
        game.boss_beaten_again("sundae", [["seal_sugar", "seal_sugar"]], home)
        destroy(self)
    }
}

func hit_by(p: vec2, r: number) -> bool {
    return state != "sleep" and state != "dying" and abs(p.x - self.x) < 20 + r and abs(p.y - self.y) < 22 + r
}

func hit(amount: number, kind: string, from: vec2) -> bool {
    if state == "intro" { return true }
    if state == "roll" {
        play_sound("sfx/clank.wav", 0.5)
        return true
    }
    if kind == "frost" or kind == "garlic_frost" { chill_t = 0.5 }
    hp -= amount
    flash_t = 0.12
    play_sound("sfx/boss_hit.wav", 0.6)
    game.boss_health(hp)
    if hp <= 0 {
        state = "dying"
        t = 0
        stop_music(0.5)
    }
    return true
}

func face_basil() -> void {
    facing = sign(basil.x - self.x)
    if facing == 0 { facing = 1 }
    self.Sprite.flip_x = facing > 0
}

func begin(s: string) -> void {
    state = s
    t = 0
}

func update(dt: number) -> void {
    if game.state != "play" and state != "intro" { return }
    if chill_t > 0 {                                   # frosted: everything slows
        chill_t -= dt
        dt = dt * 0.3
        self.Sprite.tint = rgb(170, 220, 255)
    } elif flash_t > 0 {
        flash_t -= dt
        self.Sprite.tint = rgb(255, 140, 140)
    } else {
        self.Sprite.tint = rgb(255, 255, 255)
    }
    t += dt
    if state == "sleep" {
        self.Sprite.frame = 0
        if basil.x > 64 {
            state = "intro"
            game.boss_start(NAME, HP, "music/boss.wav")
            game.talk("sundae_intro")
            play_sound("sfx/roar.wav")
        }
        return
    }
    if state == "intro" {
        if game.state == "play" and game.talking == "" { begin("idle") }
        return
    }
    if state == "dying" {
        self.Sprite.frame = 4
        if floor(t * 8) != floor((t - dt) * 8) { spawn("prefabs/burst.scene", self.position + vec2(random(-24, 24), random(-24, 24))) }
        if floor(t * 4) != floor((t - dt) * 4) { play_sound("sfx/blast.wav", 0.5) }
        self.scale = vec2(1, max(0.2, 1 - t / 2.5))
        self.y = ground + 28 * min(1, t / 2.5)
        if t > 2.5 {
            game.boss_beaten("sundae", [["seal_sugar", "seal_sugar"]], vec2(self.x, home.y + 16), "sundae_beaten")
            destroy(self)
        }
        return
    }
    if basil.touches(self.position, vec2(20, 22)) { basil.hurt(18, self.position) }
    if state == "idle" {
        face_basil()
        self.Sprite.frame = floor(t * 3) % 2
        if t > 0.9 {
            moves += 1
            if moves % 3 == 1 { begin("throw") } elif moves % 3 == 2 { begin("stomp") } else { begin("roll") }
        }
    } elif state == "throw" {
        self.Sprite.frame = 2
        if (t > 0.3 and t - dt <= 0.3) or (t > 0.7 and t - dt <= 0.7) or (t > 1.1 and t - dt <= 1.1) {
            var s := spawn("prefabs/spit.scene", self.position + vec2(facing * 20, -18))
            var dx: number = basil.x - self.x
            s.launch(vec2(clamp(dx / 55, -4, 4), -3.2), "snow")
            s.grav = 0.12
            s.damage = 12
            play_sound("sfx/jump.wav", 0.5)
        }
        if t > 1.5 { begin("idle") }
    } elif state == "stomp" {
        if t < 0.25 {
            self.Sprite.frame = 1
        } else {
            if t - dt < 0.25 { vel.y = -4.5 }
            vel.y += 0.25
            self.y += vel.y
            if self.y >= ground {
                self.y = ground
                self.Sprite.frame = 0
                shake_camera(5, 0.6)
                play_sound("sfx/quake.wav", 0.8)
                for i in 4 {
                    var ice := spawn("prefabs/spit.scene", vec2(random(40, right_wall), 36))
                    ice.launch(vec2(0, 1.5), "snow")
                    ice.grav = 0.08
                    ice.damage = 14
                }
                begin("idle")
            }
        }
    } elif state == "roll" {
        self.Sprite.frame = 3
        self.rotation += facing * 12
        if t < 0.4 { return }
        self.x += facing * 3.5
        if self.x < 40 or self.x > right_wall {
            self.x = clamp(self.x, 40, right_wall)
            facing = -facing
            bounces += 1
            shake_camera(3, 0.2)
            play_sound("sfx/blast.wav", 0.5)
            if bounces >= 3 {
                bounces = 0
                self.rotation = 0
                begin("idle")
            }
        }
    }
}
