@strict
# COUNT FROMAGE, the Lord of Spoilage. First as himself: he vanishes and appears again
# somewhere else in the throne room, sweeps his cape and flings three balls of burning
# cheese; he can be hurt only while he's there. Then as THE BIG CHEESE: a vast mouldering
# wheel that bounces about the room breathing out spores - and only garlic can hurt it.

const NAME: string = "COUNT FROMAGE"
const HP1: number = 30
const HP2: number = 50

class Spot {                               # where he can appear: his feet, and which way the room is
    var feet := vec2(0, 0)
    func init(x: number, y: number) -> void { this.feet = vec2(x, y) }
}

var home := vec2(0, 0)
var game: entity
var basil: entity
var state: string = "sleep"               # sleep, intro, gone, appear, cast, fade, change, big, dying, beaten
var hp: number = 30
var t: number = 0
var flash_t: number = 0
var spots: list[Spot] = []
var at: int = 0
var vel := vec2(1.2, -1)
var warned: bool = false
var right_wall: number = 480

func start() -> void {
    game = find("Game")
    basil = find("Basil")
    right_wall = game.room_size().x - 40
    spots = [Spot(80, 208), Spot(432, 208), Spot(112, 144), Spot(400, 144)]
    if game.flag("boss:count") {
        destroy(self)
    }
}

func phase2() -> bool { return state == "change" or state == "big" or state == "dying" }

func hit_by(p: vec2, r: number) -> bool {
    if state == "big" { return abs(p.x - self.x) < 26 + r and abs(p.y - self.y) < 26 + r }
    return (state == "cast" or state == "appear") and abs(p.x - self.x) < 10 + r and abs(p.y - self.y) < 22 + r   # (his whole height: a shot from a standing Basil hits)
}

func hit(amount: number, kind: string, from: vec2) -> bool {
    if state == "big" {
        if kind != "garlic" and kind != "garlic_frost" {
            play_sound("sfx/clank.wav", 0.4)
            if not warned {
                warned = true
                game.talk("count_no_garlic")
            }
            return true
        }
    }
    var a: number = amount
    if kind == "rocket" and not phase2() { a = 6 }
    hp -= a
    flash_t = 0.12
    play_sound("sfx/boss_hit.wav", 0.6)
    game.boss_health(hp)
    if hp <= 0 {
        if state == "big" {
            begin("dying")
            stop_music(0.5)
            play_sound("sfx/boss_die.wav")
        } else {
            begin("change")
            stop_music(0.3)
            game.talk("count_phase2")
        }
    }
    return true
}

func begin(s: string) -> void {
    state = s
    t = 0
}

func face_basil() -> void { self.Sprite.flip_x = basil.x > self.x }

func update(dt: number) -> void {
    if game.state != "play" and state != "intro" { return }
    t += dt
    var tint_a: number = 255
    if state == "gone" { tint_a = 0 }
    if state == "appear" { tint_a = 255 * min(1, t / 0.4) }
    if state == "fade" { tint_a = 255 * max(0, 1 - t / 0.4) }
    if flash_t > 0 {
        flash_t -= dt
        self.Sprite.tint = rgb(255, 140, 140, tint_a)
    } else {
        self.Sprite.tint = rgb(255, 255, 255, tint_a)
    }
    if state == "sleep" {
        self.Sprite.frame = 0
        face_basil()
        if basil.x < right_wall {
            state = "intro"
            game.boss_start(NAME, HP1, "music/count.wav")
            game.talk("count_intro")
        }
        return
    }
    if state == "intro" {
        if game.state == "play" and game.talking == "" { begin("fade") }
        return
    }
    if state == "fade" {
        self.Sprite.frame = 2
        if t > 0.4 { begin("gone") }
    } elif state == "gone" {
        if t > 0.6 {
            var next: int = floor(random(len(spots)))
            if next == at { next = (next + 1) % len(spots) }
            at = next
            var s: Spot = spots[at]
            self.position = s.feet - vec2(0, 24)
            face_basil()
            begin("appear")
            play_sound("sfx/freeze.wav", 0.5)
        }
    } elif state == "appear" {
        self.Sprite.frame = 2
        if t > 0.4 { begin("cast") }
    } elif state == "cast" {
        self.Sprite.frame = 0
        if t > 0.35 { self.Sprite.frame = 1 }
        if t > 0.5 and t - dt <= 0.5 {
            var aim: vec2 = basil.middle() - (self.position + vec2(0, -10))
            for a in [-18, 0, 18] {
                var f := spawn("prefabs/spit.scene", self.position + vec2(0, -10))
                f.launch(from_angle(angle(aim) + a, 2.3), "fire")
                f.damage = 16
            }
            play_sound("sfx/rocket.wav", 0.6)
        }
        if basil.touches(self.position, vec2(10, 22)) { basil.hurt(16, self.position) }
        if t > 1.3 { begin("fade") }
    } elif state == "change" {
        if game.talking != "" { return }
        if t < 2.0 {                                   # he swells into the Big Cheese
            self.Sprite.tint = rgb(255, 255, 255)
            self.scale = vec2(1 + t * 0.5, 1 + t * 0.5)
            shake_camera(3, 0.2)
            if floor(t * 6) != floor((t - dt) * 6) { play_sound("sfx/quake.wav", 0.4) }
            return
        }
        self.scale = vec2(1, 1)
        self.Sprite.image = "art/boss_bigcheese.bmp"
        self.Sprite.frame_size = vec2(64, 64)
        self.position = vec2(256, 120)
        hp = HP2
        game.boss_start("THE BIG CHEESE", HP2, "music/count.wav")
        begin("big")
    } elif state == "big" {
        self.Sprite.frame = floor(t * 3) % 2
        self.position = self.position + vel
        if self.x < 48 or self.x > right_wall - 8 { vel.x = -vel.x }
        if self.y < 60 or self.y > 176 { vel.y = -vel.y }
        self.rotation += vel.x * 2
        if floor(t / 3) != floor((t - dt) / 3) {
            self.Sprite.frame = 2
            for i in 3 {
                var s := spawn("prefabs/spore.scene", self.position + from_angle(i * 120, 20), self.parent)
            }
            play_sound("sfx/pop.wav", 0.6)
        }
        if basil.touches(self.position, vec2(26, 26)) { basil.hurt(20, self.position) }
    } elif state == "dying" {
        self.rotation += 6
        if floor(t * 10) != floor((t - dt) * 10) { spawn("prefabs/burst.scene", self.position + vec2(random(-28, 28), random(-28, 28))) }
        self.scale = vec2(max(0.1, 1 - t / 3), max(0.1, 1 - t / 3))
        self.Sprite.tint = rgb(255, 255, 255, 255 * max(0, 1 - t / 3))
        if t > 3 {
            for s in find_tagged("spore") { destroy(s) }
            game.boss_beaten("count", [], self.position, "count_beaten")
            destroy(self)
        }
    }
}
