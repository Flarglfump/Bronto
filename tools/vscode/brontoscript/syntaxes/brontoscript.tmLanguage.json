{
 "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
 "name": "BrontoScript",
 "scopeName": "source.brontoscript",
 "fileTypes": [
  "bs"
 ],
 "patterns": [
  {
   "include": "#comment"
  },
  {
   "include": "#string"
  },
  {
   "include": "#annotation"
  },
  {
   "include": "#class-def"
  },
  {
   "include": "#type"
  },
  {
   "include": "#function-def"
  },
  {
   "include": "#var-def"
  },
  {
   "include": "#keyword"
  },
  {
   "include": "#constant"
  },
  {
   "include": "#number"
  },
  {
   "include": "#self"
  },
  {
   "include": "#member"
  },
  {
   "include": "#call"
  },
  {
   "include": "#operator"
  }
 ],
 "repository": {
  "comment": {
   "name": "comment.line.number-sign.brontoscript",
   "match": "#.*$"
  },
  "string": {
   "patterns": [
    {
     "name": "string.quoted.double.brontoscript",
     "begin": "\"",
     "end": "\"|$",
     "patterns": [
      {
       "name": "constant.character.escape.brontoscript",
       "match": "\\\\."
      }
     ]
    },
    {
     "name": "string.quoted.single.brontoscript",
     "begin": "'",
     "end": "'|$",
     "patterns": [
      {
       "name": "constant.character.escape.brontoscript",
       "match": "\\\\."
      }
     ]
    }
   ]
  },
  "function-def": {
   "match": "\\b(func)\\s+([A-Za-z_]\\w*)\\s*\\(([^)]*)\\)",
   "captures": {
    "1": {
     "name": "storage.type.function.brontoscript"
    },
    "2": {
     "patterns": [
      {
       "match": "\\b(?:start|update|on_collision|on_collision_end|on_trigger|on_trigger_exit|draw|on_pause|on_resume)\\b",
       "name": "entity.name.function.callback.brontoscript support.function.callback.brontoscript"
      },
      {
       "match": "[A-Za-z_]\\w*",
       "name": "entity.name.function.brontoscript"
      }
     ]
    },
    "3": {
     "patterns": [
      {
       "match": "(:)\\s*((?:unsigned\\s+)?[A-Za-z_]\\w*)(?:\\s*\\[\\s*((?:unsigned\\s+)?[A-Za-z_]\\w*)\\s*\\])?",
       "captures": {
        "1": {
         "name": "punctuation.separator.type.brontoscript"
        },
        "2": {
         "name": "support.type.brontoscript"
        },
        "3": {
         "name": "support.type.brontoscript"
        }
       }
      },
      {
       "match": "[A-Za-z_]\\w*",
       "name": "variable.parameter.brontoscript"
      }
     ]
    }
   }
  },
  "var-def": {
   "match": "\\b(var|const(?:\\s+var)?)\\s+([A-Za-z_]\\w*)",
   "captures": {
    "1": {
     "name": "storage.type.brontoscript"
    },
    "2": {
     "name": "variable.other.declaration.brontoscript"
    }
   }
  },
  "keyword": {
   "patterns": [
    {
     "name": "keyword.control.brontoscript",
     "match": "\\b(?:if|elif|else|while|for|in|return|break|continue)\\b"
    },
    {
     "name": "keyword.operator.logical.brontoscript",
     "match": "\\b(?:and|or|not)\\b"
    },
    {
     "name": "storage.type.brontoscript",
     "match": "\\b(?:var|func|const|struct|class|component)\\b"
    },
    {
     "name": "storage.modifier.brontoscript",
     "match": "\\b(?:public|private|protected|static|override|unsigned)\\b"
    }
   ]
  },
  "constant": {
   "name": "constant.language.brontoscript",
   "match": "\\b(?:true|false|nil)\\b"
  },
  "number": {
   "name": "constant.numeric.brontoscript",
   "match": "\\b\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b|\\B\\.\\d+\\b"
  },
  "self": {
   "patterns": [
    {
     "name": "variable.language.self.brontoscript",
     "match": "\\bself\\b"
    },
    {
     "name": "variable.language.this.brontoscript",
     "match": "\\b(?:this|super)\\b"
    }
   ]
  },
  "member": {
   "patterns": [
    {
     "match": "(\\.)\\s*([A-Z]\\w*)\\b",
     "captures": {
      "1": {
       "name": "punctuation.accessor.brontoscript"
      },
      "2": {
       "name": "entity.name.type.component.brontoscript"
      }
     }
    },
    {
     "match": "(\\.)\\s*([A-Za-z_]\\w*)\\s*(?=\\()",
     "captures": {
      "1": {
       "name": "punctuation.accessor.brontoscript"
      },
      "2": {
       "name": "entity.name.function.member.brontoscript"
      }
     }
    },
    {
     "match": "(\\.)\\s*(?:(name|position|x|y|rotation|scale|global_position|global_rotation|parent|velocity|angular_velocity|alive|id)|([A-Za-z_]\\w*))\\b",
     "captures": {
      "1": {
       "name": "punctuation.accessor.brontoscript"
      },
      "2": {
       "name": "support.variable.property.brontoscript"
      },
      "3": {
       "name": "variable.other.property.brontoscript"
      }
     }
    }
   ]
  },
  "call": {
   "patterns": [
    {
     "match": "\\b(print|str|num|floor|ceil|round|abs|sqrt|sin|cos|atan2|pow|sign|min|max|clamp|lerp|random|vec2|vec3|cross|length|normalize|dot|distance|angle|from_angle|rgb|len|push|pop|remove|contains|range|key_down|key_pressed|key_released|mouse_down|mouse_pressed|mouse_position|time|button_down|button_pressed|button_released|axis|stick|gamepad_connected|gamepad_count|gamepad_name|last_button|last_input|rumble|touch_controls_shown|show_touch_controls|set_touch_controls|find|find_all|find_with|find_tagged|first_tagged|has_tag|add_tag|remove_tag|tags|destroy|spawn|children|child|has|add|remove_component|apply_force|apply_impulse|apply_torque|raycast|entity_at|overlap_sphere|look_at|move_and_slide|is_on_floor|is_on_wall|is_on_ceiling|emit|particle_count|tween|tween_repeat|tween_then|stop_tween|is_tweening|ease|world_to_screen|screen_ray|play_sound|send|load_scene|quit|tile_at|set_tile|tile_solid|tile_center|substr|save_data|load_data|has_data|delete_data|data_names|last_key|set_volume|volume|draw_rect|draw_line|draw_circle|draw_text|draw_image|text_size|camera|shake_camera|snap_camera|screen_to_world|world_to_screen|play_animation|stop_animation|animation_clips|stop_sound|sound_playing|set_sound_volume|set_sound_pitch|set_sound_pan|pause_sound|stop_sounds|sound_length|play_music|stop_music|music|play_tone|broadcast|push_scene|pop_scene|set_global|global|has_global|delete_global|set_fullscreen|fullscreen|set_window_title|show_cursor|screen_size|mouse_released|mouse_wheel|mouse_motion|lock_mouse|mouse_locked|text_typed|touches|bind|unbind|action_down|action_pressed|action_released|action_axis|gravity|set_gravity|tile_cell|tile_get|tile_put|tile_cell_center|tile_box_solid|random_seed|clipboard|set_clipboard|fps|frame_count|log_warning|log_error|open_url|image_size)\\s*(?=\\()",
     "captures": {
      "1": {
       "name": "support.function.builtin.brontoscript"
      }
     }
    },
    {
     "match": "\\b([A-Za-z_]\\w*)\\s*(?=\\()",
     "captures": {
      "1": {
       "name": "entity.name.function.call.brontoscript"
      }
     }
    }
   ]
  },
  "operator": {
   "patterns": [
    {
     "name": "keyword.operator.assignment.compound.brontoscript",
     "match": "[-+*/]="
    },
    {
     "name": "keyword.operator.comparison.brontoscript",
     "match": "==|!=|<=|>=|<|>"
    },
    {
     "name": "keyword.operator.assignment.brontoscript",
     "match": "="
    },
    {
     "name": "keyword.operator.arithmetic.brontoscript",
     "match": "[-+*/%]"
    }
   ]
  },
  "annotation": {
   "name": "storage.modifier.annotation.brontoscript",
   "match": "@\\w+"
  },
  "type": {
   "patterns": [
    {
     "match": "(->)\\s*((?:unsigned\\s+)?[A-Za-z_]\\w*)(?:\\s*\\[\\s*((?:unsigned\\s+)?[A-Za-z_]\\w*)\\s*\\])?",
     "captures": {
      "1": {
       "name": "keyword.operator.arrow.brontoscript"
      },
      "2": {
       "name": "support.type.brontoscript"
      },
      "3": {
       "name": "support.type.brontoscript"
      }
     }
    },
    {
     "match": "(:)(?!=)\\s*((?:unsigned\\s+)?[A-Za-z_]\\w*)(?:\\s*\\[\\s*((?:unsigned\\s+)?[A-Za-z_]\\w*)\\s*\\])?",
     "captures": {
      "1": {
       "name": "punctuation.separator.type.brontoscript"
      },
      "2": {
       "name": "support.type.brontoscript"
      },
      "3": {
       "name": "support.type.brontoscript"
      }
     }
    },
    {
     "match": ":=",
     "name": "keyword.operator.assignment.infer.brontoscript"
    }
   ]
  },
  "class-def": {
   "match": "\\b(struct|class|component)\\s+([A-Za-z_]\\w*)(?:\\s*(:)\\s*([A-Za-z_]\\w*))?",
   "captures": {
    "1": {
     "name": "storage.type.brontoscript"
    },
    "2": {
     "name": "entity.name.type.class.brontoscript"
    },
    "3": {
     "name": "punctuation.separator.inheritance.brontoscript"
    },
    "4": {
     "name": "entity.other.inherited-class.brontoscript"
    }
   }
  }
 }
}